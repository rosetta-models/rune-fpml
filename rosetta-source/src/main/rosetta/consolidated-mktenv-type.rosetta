namespace fpml.consolidated.mktenv : < "fpml definition" >
version "${project.version}"

import fpml.consolidated.asset.*
import fpml.consolidated.cd.*
import fpml.consolidated.^enum.*
import fpml.consolidated.option.shared.*
import fpml.consolidated.riskdef.*
import fpml.consolidated.shared.*

type CreditCurve extends PricingStructure: <"A generic credit curve providing credit-related market inputs for valuation and risk calculations as a concrete pricing structure. A generic credit curve definition.">

    referenceEntity LegalEntity (0..1) <"The entity for which this is defined.">
    creditEntityReference LegalEntityReference (0..1) <"An XML reference a credit entity defined elsewhere in the document.">
    creditEvents CreditEvents (0..1) <"The material credit event.">
    seniority CreditSeniority (0..1) <"The level of seniority of the deliverable obligation.">
    secured boolean (0..1) <"Whether the deliverable obligation is secured or unsecured.">
    obligationCurrency Currency (0..1) <"The currency of denomination of the deliverable obligation.">
    obligations Obligations (0..1) <"The underlying obligations of the reference entity on which you are buying or selling protection">
    deliverableObligations DeliverableObligations (0..1) <"What sort of obligation may be delivered in the event of the credit event. ISDA 2003 Term: Obligation Category/Deliverable Obligation Category">

    condition Choice:
        optional choice referenceEntity, creditEntityReference

type CreditCurveValuation extends PricingStructureValuation: <"A set of credit curve values comprising pricing inputs, typically credit spreads, default probabilities, and recovery rates. A set of credit curve values, which can include pricing inputs (which are typically credit spreads), default probabilities, and recovery rates.">

    ^inputs QuotedAssetSet (0..1) <"A collection of quoted assets providing the pricing inputs used to determine the credit curve valuation.">
    defaultProbabilityCurve DefaultProbabilityCurve (0..1) <"A curve of default probabilities.">
    recoveryRate number (0..1) <"A single recovery rate, to be used for all terms.">
    recoveryRateCurve TermCurve (0..1) <"A curve of recovery rates, allowing different terms to have different recovery rates.">

    condition Choice:
        optional choice recoveryRate, recoveryRateCurve

type FxCurve extends PricingStructure: <"A foreign exchange curve containing pricing inputs and term structures used to value foreign exchange forwards. An fx curve object., which includes pricing inputs and term structures for fx forwards.">

    quotedCurrencyPair QuotedCurrencyPair (0..1) <"Defines the two currencies for an FX trade and the quotation relationship between the two currencies.">

type FxCurveValuation extends PricingStructureValuation: <"A valuation of an FX curve object, including pricing inputs and term structures for foreign exchange forwards. A valuation of an FX curve object., which includes pricing inputs and term structures for fx forwards.">

    settlementCurrencyYieldCurve PricingStructureReference (0..1) <"A reference to the yield curve for the settlement currency used as a pricing input in the FX curve valuation.">
    forecastCurrencyYieldCurve PricingStructureReference (0..1) <"A reference to the yield curve for the forecast currency used as an input to the FX curve valuation.">
    spotRate FxRateSet (0..1) <"A collection of quoted spot foreign exchange rates used as pricing inputs for the FX curve valuation.">
    fxForwardCurve TermCurve (0..1) <"A curve of fx forward rates.">
    fxForwardPointsCurve TermCurve (0..1) <"A curve of fx forward point spreads.">

type VolatilityMatrixValuation extends VolatilityMatrix: <"Valuation data structured as a volatility matrix whose dimensionality ranges from zero to three dimensions.">

type VolatilityRepresentation extends PricingStructure: <"Representation of an asset’s volatilities whose values can be supplied in a specific volatility matrix. A representation of volatilities of an asset. This is a generic structure whose values can be supplied in a specific volatility matrix.">

    asset AssetReference (0..1) <"A reference to the asset whose volatility is modeled.">
    yieldCurveReference YieldCurveReference (0..1) <"A reference to the yield curve whose volatility is modeled.">

    condition Choice:
        optional choice asset, yieldCurveReference

type YieldCurve extends PricingStructure: <"A generic yield curve pricing structure that can be valued using a variety of valuation methods. A generic yield curve object, which can be valued in a variety of ways.">

    algorithm NonEmptyNormalizedString (0..1) <"Provides the nonempty textual designation of the computational method used to generate the characterized yield curve outputs.">
    forecastRateIndex ForecastRateIndex (0..1) <"Identifies the rate index whose future rate values are represented by the yield curve outputs.">

type YieldCurveValuation extends PricingStructureValuation: <"Values of a yield curve, potentially including inputs and outputs such as discount factors, forward rates, and zero rates. The values of a yield curve, including possibly inputs and outputs (dfs, forwards, zero rates).">

    ^inputs QuotedAssetSet (0..1) <"The collection of quoted assets used as inputs to the valuation and derivation of the represented yield curves.">
    zeroCurve ZeroRateCurve (0..1) <"A curve of zero rates.">
    forwardCurve ForwardRateCurve (0..*) <"A curve of forward rates.">
    discountFactorCurve TermCurve (0..1) <"A curve of discount factors.">

type CompoundingFrequency:

    value Scheme (1..1)
    compoundingFrequencyScheme NonEmptyURI (0..1)

type DefaultProbabilityCurve extends PricingStructureValuation: <"A set of default probabilities.">

    baseYieldCurve PricingStructureReference (0..1) <"A reference to the yield curve values used as a basis for this credit curve valuation.">
    defaultProbabilities TermCurve (0..1) <"A collection of default probabilities.">

type ForwardRateCurve: <"A curve used to model a set of forward interest rates. Used for forecasting interest rates as part of a pricing calculation.">

    assetReference AssetReference (0..1) <"A reference to the rate index whose forwards are modeled.">
    rateCurve TermCurve (0..1) <"The curve of forward values.">

type FxRateSet extends QuotedAssetSet: <"A collection of spot FX rates used in pricing.">

type MultiDimensionalPricingData: <"A pricing data set that contains a series of points with coordinates. It is a sparse matrix representation of a multi-dimensional matrix.">

    measureType AssetMeasureType (0..1) <"The type of the value that is measured. This could be an NPV, a cash flow, a clean price, etc.">
    quoteUnits PriceQuoteUnits (0..1) <"The optional units that the measure is expressed in. If not supplied, this is assumed to be a price/value in currency units.">
    side QuotationSideEnum (0..1) <"The side (bid/mid/ask) of the measure.">
    currency Currency (0..1) <"The optional currency that the measure is expressed in. If not supplied, this is defaulted from the reportingCurrency in the valuationScenarioDefinition.">
    currencyType ReportingCurrencyType (0..1) <"The optional currency that the measure is expressed in. If not supplied, this is defaulted from the reportingCurrency in the valuationScenarioDefinition.">
    timing QuoteTiming (0..1) <"When during a day the quote is for. Typically, if this element is supplied, the QuoteLocation needs also to be supplied.">
    businessCenter BusinessCenter (0..1) <"A city or other business center.">
    exchangeId ExchangeId (0..1) <"The exchange (e.g. stock or futures exchange) from which the quote is obtained.">
    informationSource InformationSource (0..*) <"The information source where a published or displayed market rate will be obtained, e.g. Telerate Page 3750.">
    pricingModel PricingModel (0..1) <".">
    time zonedDateTime (0..1) <"When the quote was observed or when a calculated value was generated.">
    valuationDate zonedDateTime (0..1) <"When the quote was computed.">
    expiryTime zonedDateTime (0..1) <"When does the quote cease to be valid.">
    cashflowType CashflowType (0..1) <"For cash flows, the type of the cash flows. Examples include: Coupon payment, Premium Fee, Settlement Fee, Brokerage Fee, etc.">
    point PricingStructurePoint (0..*) <"A single pricing value associated with coordinates identifying its position within the sparse multidimensional pricing data set.">

    condition Choice:
        optional choice businessCenter, exchangeId

type ParametricAdjustment: <"An adjustment used to accommodate a parameter of the input trade, e.g. the strike.">

    name NormalizedString (0..1) <"The name of the adjustment parameter (e.g. \"Volatility Skew\").">
    inputUnits PriceQuoteUnits (0..1) <"The units of the input parameter, e.g. Yield.">
    datapoint ParametricAdjustmentPoint (0..*) <"The values of the adjustment parameter.">

type ParametricAdjustmentPoint: <"A value of the adjustment point, consisting of the x value and the corresponding y value.">

    parameterValue number (0..1) <"The value of the independent variable (e.g. strike offset).">
    adjustmentValue number (0..1) <"The value of the dependent variable, the actual adjustment amount.">

type PricingStructurePoint: <"A single valued point with a set of coordinates that define an arbitrary number of indentifying indexes (0 or more). Note that the collection of coordinates/coordinate references for a PricingStructurePoint must not define a given dimension (other than \"generic\") more than once. This is to avoid ambiguity.">

    id string (0..1)
    pricingStructurePointChoice PricingStructurePointChoice (0..*)
    underlyingAsset Asset (0..1)
    underlyingAssetReference AssetReference (0..1) <"A reference to an underlying asset that defines the meaning of the value, i.e. the product that the value corresponds to. For example, this could be a caplet or simple european swaption.">
    value number (0..1) <"The value of the the quotation.">
    measureType AssetMeasureType (0..1) <"The type of the value that is measured. This could be an NPV, a cash flow, a clean price, etc.">
    quoteUnits PriceQuoteUnits (0..1) <"The optional units that the measure is expressed in. If not supplied, this is assumed to be a price/value in currency units.">
    side QuotationSideEnum (0..1) <"The side (bid/mid/ask) of the measure.">
    currency Currency (0..1) <"The optional currency that the measure is expressed in. If not supplied, this is defaulted from the reportingCurrency in the valuationScenarioDefinition.">
    currencyType ReportingCurrencyType (0..1) <"The optional currency that the measure is expressed in. If not supplied, this is defaulted from the reportingCurrency in the valuationScenarioDefinition.">
    timing QuoteTiming (0..1) <"When during a day the quote is for. Typically, if this element is supplied, the QuoteLocation needs also to be supplied.">
    businessCenter BusinessCenter (0..1) <"A city or other business center.">
    exchangeId ExchangeId (0..1) <"The exchange (e.g. stock or futures exchange) from which the quote is obtained.">
    informationSource InformationSource (0..*) <"The information source where a published or displayed market rate will be obtained, e.g. Telerate Page 3750.">
    pricingModel PricingModel (0..1) <".">
    time zonedDateTime (0..1) <"When the quote was observed or when a calculated value was generated.">
    valuationDate zonedDateTime (0..1) <"When the quote was computed.">
    expiryTime zonedDateTime (0..1) <"When does the quote cease to be valid.">
    cashflowType CashflowType (0..1) <"For cash flows, the type of the cash flows. Examples include: Coupon payment, Premium Fee, Settlement Fee, Brokerage Fee, etc.">

    condition Choice0:
        optional choice underlyingAsset, underlyingAssetReference

    condition Choice1:
        optional choice businessCenter, exchangeId

type PricingStructurePointChoice:

    coordinate PricingDataPointCoordinate (0..1) <"An explicit, filled in data point coordinate. This might specify expiration, strike, etc.">
    coordinateReference PricingDataPointCoordinateReference (0..1) <"A reference to a pricing data point coordinate within this document.">

    condition Choice:
        one-of

type TermCurve: <"A curve consisting only of values over a term. This is a restricted form of One Dimensional Structure.">

    interpolationMethod InterpolationMethod (0..1) <"Specifies the coding-scheme value identifying the interpolation technique used to derive values between defined term curve points.">
    extrapolationPermitted boolean (0..1) <"Indicates whether values may be extrapolated beyond the range of specified term points when evaluating the curve.">
    point TermPoint (0..*) <"A value point on the term curve, supporting a time dimension and bid, mid, ask, or spread values.">

type TermPoint: <"A value point that can have a time dimension. Allows bid, mid, ask, and spread values to be represented.">

    id string (0..1)
    term TimeDimension (0..1) <"The time dimension of the point (tenor and/or date)">
    bid number (0..1) <"A price \"bid\" by a buyer for an asset, i.e. the price a buyer is willing to pay.">
    mid number (0..1) <"A price midway between the bid and the ask price.">
    ask number (0..1) <"A price \"asked\" by a seller for an asset, i.e. the price at which a seller is willing to sell.">
    spreadValue number (0..1) <"The spread value can be used in conjunction with the \"mid\" value to define the bid and the ask value.">
    definition AssetReference (0..1) <"An optional reference to an underlying asset that defines the meaning of the value, i.e. the product that the value corresponds to. For example, this could be a discount instrument.">

type VolatilityMatrix extends PricingStructureValuation: <"A matrix of volatilities with dimension 0-3.">

    dataPoints MultiDimensionalPricingData (0..1) <"The raw volatility matrix data, expressed as a multi-dimensional array.">
    adjustment ParametricAdjustment (0..*) <"An adjustment factor, such as for vol smile/skew.">

type YieldCurveReference extends Reference: <"Reference to a yield curve.">

    href string (1..1)

type ZeroRateCurve: <"A curve used to model a set of zero-coupon interest rates.">

    compoundingFrequency CompoundingFrequency (0..1) <"The frequency at which the rates are compounded (e.g. continuously compounded).">
    rateCurve TermCurve (0..1) <"The curve of zero-coupon values.">
