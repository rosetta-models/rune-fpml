namespace fpml.consolidated.recordkeeping.processes : < "fpml definition" >
version "${project.version}"

import fpml.consolidated.asset.*
import fpml.consolidated.business.events.*
import fpml.consolidated.doc.*
import fpml.consolidated.fpmlenum.*
import fpml.consolidated.msg.*
import fpml.consolidated.reg.fpmlreporting.shared.*
import fpml.consolidated.shared.*

type NonpublicExecutionReport extends CorrectableRequestMessage: <"Non public execution report message.">
    [rootType]

    asOfDate IdentifiedDate (0..1) <"The date for which this document reports positions \t\t\t\t\t\t\t\tand valuations.">
    asOfTime time (0..1) <"The time for which this report was generated (i.e., \t\t\t\t\t\t\t\tthe cut-off time of the report).">
    portfolioReference PortfolioReferenceBase (0..1) <"A reference structure identifying the portfolio to which the response message relates within the applicable messaging process.">
    originatingEvent OriginatingEvent (0..1) <"Identifies the business event that caused generation of the non-public execution report, using an applicable coding scheme.">
    trade Trade (0..1) <"The trade associated with the execution or lifecycle event reported for non-public regulatory recordkeeping.">
    tradingEvent TradingEventSummary (0..*) <"This is provided to support snapshot \t\t\t\t\t\t\t\t\t\treporting that requires trading history. Some \t\t\t\t\t\t\t\t\t\timplementations are using the \"trade\" event to report the \t\t\t\t\t\t\t\t\t\tcurrent snapshot of a contract. In these cases it may also \t\t\t\t\t\t\t\t\t\tbe necessary to report the most recent trading event to \t\t\t\t\t\t\t\t\t\tsupport regulatory reporting mandates. For this reason the \t\t\t\t\t\t\t\t\t\ttradingEvent is provided to allow that event to be attached \t\t\t\t\t\t\t\t\t\tto the trade report.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    change TradeChangeContent (0..1) <"Represents the change event associated with a trade.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Specifies a customized business event constituting the subject of the non-public execution report beyond the defined standard trade lifecycle event forms.">
    quote BasicQuotation (0..*) <"Pricing information for the trade.">
    scheduledDate ScheduledDateBase (0..*) <"Upcoming important dates for the trade. Added to \t\t\t\t\t\t\t\tsupport CFTC Amendments to Part 43/45 (Published November \t\t\t\t\t\t\t\t2020).">
    collateralization RegulatoryReportingCollateralization (0..2) <"Collateral information associated with the reported trade or lifecycle event and supplied for non-public regulatory recordkeeping and reporting.">
    party Party (0..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if trade exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if increase exists
        then amendment is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if termination exists
        then amendment is absent
                and increase is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if novation exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if withdrawal exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if reset exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if change exists
        then originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if optionExercise exists
        then optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and additionalEvent is absent
        else if optionExpiry exists
        then optionExercise is absent
                and optionEvent is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and additionalEvent is absent
        else if optionEvent exists
        then optionExercise is absent
                and optionExpiry is absent
                and originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and additionalEvent is absent
        else if additionalEvent exists
        then originatingEvent is absent
                and trade is absent
                and tradingEvent is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
        else increase is absent
            and terminatingEvent is absent
            and termination is absent
            and novation is absent
            and withdrawal is absent
            and observation is absent
            and reset is absent
            and originatingEvent is absent
            and trade is absent
            and tradingEvent is absent
            and change is absent
            and optionExercise is absent
            and optionExpiry is absent
            and optionEvent is absent
            and additionalEvent is absent

type NonpublicExecutionReportAcknowledgement extends Acknowledgement: <"Acknowledgement message for \t\t\t\tnonpublicExecutionReport.">
    [rootType]

type NonpublicExecutionReportException extends Exception: <"Exception message for nonpublicExecutionReport.">
    [rootType]

type NonpublicExecutionReportRetracted extends NonCorrectableRequestMessage: <"Retraction message for nonpublicExecutionReport.">
    [rootType]

    originatingEvent OriginatingEvent (0..1) <"Provides a scheme-qualified code identifying the event that originated the non-public execution report being retracted.">
    trade Trade (0..1) <"The trade associated with the execution report being retracted, providing transaction details relevant to its identification and regulatory recordkeeping.">
    tradingEvent TradingEventSummary (0..*) <"This is provided to support snapshot \t\t\t\t\t\t\t\t\t\t\treporting that requires trading history. Some \t\t\t\t\t\t\t\t\t\t\timplementations are using the \"trade\" event to report \t\t\t\t\t\t\t\t\t\t\tthe current snapshot of a contract. In these cases it \t\t\t\t\t\t\t\t\t\t\tmay also be necessary to report the most recent trading \t\t\t\t\t\t\t\t\t\t\tevent to support regulatory reporting mandates. For this \t\t\t\t\t\t\t\t\t\t\treason the tradingEvent is provided to allow that event \t\t\t\t\t\t\t\t\t\t\tto be attached to the trade report.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    change TradeChangeContent (0..1) <"Represents the change event associated with a trade.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Identifies a customized business event to which the retraction of the non-public execution report relates.">
    primaryAssetClass AssetClass (0..1) <"Identifies, using an asset classification scheme, the principal asset category of the transaction or business event referenced by the retracted non-public execution report.">
    tradeIdentifier PartyTradeIdentifier (0..1) <"Identifies the trade whose non-public execution report is being retracted, using one or more identifiers allocated by a party, including any link identifier associating it with related trades.">
    eventIdentifier BusinessEventIdentifier (0..2) <"Individual parties should only use a single \t\t\t\t\t\t\t\t\t\tevent identifier to identify a retraction. Platforms \t\t\t\t\t\t\t\t\t\tproviding services on behalf of both parties in a \t\t\t\t\t\t\t\t\t\ttransaction may provide event identifiers for both parties; \t\t\t\t\t\t\t\t\t\tin this case it is up to the recipient (the trade \t\t\t\t\t\t\t\t\t\trepository) to validate that the event IDs refer to the same \t\t\t\t\t\t\t\t\t\tevent.">
    relatedParty RelatedParty (0..*) <"This may be used to identify one or more \t\t\t\t\t\t\t\t\t\tparties that perform a role within the transaction. If this \t\t\t\t\t\t\t\t\t\tis within a partyTradeInformation block, the related party \t\t\t\t\t\t\t\t\t\tperforms the role with respect to the party identifie by the \t\t\t\t\t\t\t\t\t\t\"partyReference\" in the partyTradeInformation \t\t\t\t\t\t\t\t\t\tblock.">
    party Party (0..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if trade exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if increase exists
        then amendment is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if termination exists
        then amendment is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if novation exists
        then amendment is absent
                and terminatingEvent is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if withdrawal exists
        then amendment is absent
                and terminatingEvent is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if reset exists
        then amendment is absent
                and terminatingEvent is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if change exists
        then originatingEvent is absent
                and tradingEvent is absent
                and amendment is absent
                and terminatingEvent is absent
                and observation is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if optionExercise exists
        then optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and amendment is absent
                and terminatingEvent is absent
                and observation is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if optionExpiry exists
        then optionEvent is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and amendment is absent
                and terminatingEvent is absent
                and observation is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if optionEvent exists
        then originatingEvent is absent
                and tradingEvent is absent
                and amendment is absent
                and terminatingEvent is absent
                and observation is absent
                and additionalEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else if additionalEvent exists
        then originatingEvent is absent
                and tradingEvent is absent
                and amendment is absent
                and terminatingEvent is absent
                and observation is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
        else terminatingEvent is absent
                and observation is absent
                and originatingEvent is absent
                and tradingEvent is absent
                and primaryAssetClass is absent
                and tradeIdentifier is absent
                and eventIdentifier is absent
                and relatedParty is absent
            or originatingEvent is absent
                and tradingEvent is absent
                and amendment is absent
                and terminatingEvent is absent
                and observation is absent

type RegulatoryDisclosure extends AddressedMessage: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2024-12-12). Regulatory disclosure message used for reporting to trade \t\t\t\trepositories. DEPRECATED. Not in use (RPTWG decision \t\t\t\t2024-12-12). A type that defines a message to be used for reporting non-public \t\t\t\tinformation to a regulator, typically via a trade repository or other reporting \t\t\t\tservice. CAVEAT: This new regulatory reporting message set is supported by the FpML \t\t\t\tStandards Committee, and will be present in future versions of the standard. \t\t\t\tHowever, there is no absolute guarantee of backward compatibility with future \t\t\t\tversions of the standard, until such time as the Standards Committee deems that the \t\t\t\tmessage set has been extensively adopted in production. The Standards Committee will \t\t\t\tattempt to maintain full backward compatibility with this version while adjusting as \t\t\t\trequired to take into account implementation experience with the message set. The \t\t\t\tStandards Committee advises that the areas where there is more likely to be change \t\t\t\tinclude the applicableRegulatiorns section, the regulatorionSpecificInformation \t\t\t\tsection, and the regulatoryProductInformation [DEPRECATED] product, which is \t\t\t\tdeveloped as part of this reporting framework. Feedback or questions can be \t\t\t\taddressed to ISDA at rptwgchair@fpml.org.">
    [rootType]

    isCorrection boolean (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Indicates if this message corrects an earlier \t\t\t\t\t\t\t\tsubmission. If true, the recipient is directed to record information \t\t\t\t\t\t\t\tabout the most recent lifecycle event affecting the trade as a \t\t\t\t\t\t\t\tcorrection of the previous submission, rather than as a new \t\t\t\t\t\t\t\tlifecycle event.">
    onBehalfOf OnBehalfOf (0..4) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Indicates which party (or parties) (and accounts) a \t\t\t\t\t\t\t\ttrade or event is being processed for. Normally there will only be a \t\t\t\t\t\t\t\tmaximum of 2 parties, but in the case of a novation there could be a \t\t\t\t\t\t\t\ttransferor, transferee, remaining party, and other remaining party. \t\t\t\t\t\t\t\tAlso, in the context of a trade package there could be several \t\t\t\t\t\t\t\tparties for which limit check is requested, necessitating multiple \t\t\t\t\t\t\t\tonBehalfOf elements. Except for these cases, there should be no more \t\t\t\t\t\t\t\tthan two onBehalfOf references in a message.">
    asOfDate IdentifiedDate (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). The date for which this document reports positions \t\t\t\t\t\t\t\tand valuations.">
    asOfTime time (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). The time for which this report was generated (i.e., \t\t\t\t\t\t\t\tthe cut-off time of the report).">
    eventId EventId (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). A unique event identifier.">
    eventType EventTaxonomy (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). A structured code indicating the event \t\t\t\t\t\t\t\ttype.">
    eventTimestamps EventTimestamps (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Various timestamps related to the \t\t\t\t\t\t\t\tevent.">
    reportingPartyReference PartyReference (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). A reference to the reporting party.">
    counterPartyReference PartyReference (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). A reference to the reporting party.">
    notionalChange NotionalChangeEnum (0..1) <"Indication as to whether the transaction is an increase or decrease of notional of a derivative contract. Only applies when there is change in notional for a derivative contract">
    changeInNotional MoneyRef (0..*) <"The change in notional amount for a prior report as a result of this event. The current notional will be reported in the trade itself. This corresponds to MiFIR Nominal or Monetary amount values; these can be distinguished by the esmaNotionalType indicator.">
    changeInNumberOfOptions AmountRef (0..*) <"The change in nominal amount from a prior report as a result of this event. The current number of options will be reported in the trade itself. This corresponds to the MiFIR \"units\" value.">
    changeInQuantity UnitQuantityRef (0..*) <"The change in quantity(s) from a prior report as a result of this event. The current quantity will be reported in the trade itself. This corresponds to the MiFIR \"units\" value.">
    payment NonNegativePayment (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Payments in settlement of the \t\t\t\t\t\t\t\tevent">
    applicableRegulations ApplicableRegulations (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). All the regulators to which this trade should be \t\t\t\t\t\t\t\treported. Optional, can be infeerred from the list of regulations to \t\t\t\t\t\t\t\twhich the trade is submitted.">
    regulationSpecificInformation RegulationDetails (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). All the regulations that this trade should be \t\t\t\t\t\t\t\treported under.">
    cpmiIoscoCDE RegReportingCDE (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). The revised state of the trade or its final state for \t\t\t\t\t\t\t\ta lifecycle ending event">
    trade Trade (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). The revised state of the trade or its final state for \t\t\t\t\t\t\t\ta lifecycle ending event">
    quote BasicQuotation (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Pricing information for the \t\t\t\t\t\t\t\ttrade.">
    collateralization RegulatoryReportingCollateralization (0..2) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12).">
    party Party (1..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). The supporting party definitions.">

    condition Choice:
        optional choice changeInNotional, changeInNumberOfOptions, changeInQuantity

type RegulatoryReportingAcknowledgement extends Message: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Used to report that a regulatory reporting message (e.g. regulatory \t\t\t\tdisclosure or withdrawal) was processed successfully, and the status of reporting to \t\t\t\tany regulators. DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). A type defining an acknowledgement to a regulatory reporting \t\t\t\tsubmission, e.g. regulatoryDisclosure or regulatoryWithdrawal.">
    [rootType]

    header ResponseMessageHeader (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Standard FpML message header">
    tradeIdentifier PartyTradeIdentifier (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). identifies the affected trade">
    reportingStatus ReportingStatus (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Information about how the position is being reported \t\t\t\t\t\t\t\tto regulators.">
    additionalData AdditionalData (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25).">
    party Party (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Reference information about parties, business units, \t\t\t\t\t\t\t\tand persons involed in the trade.">

type RegulatoryReportingException extends Message: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Used to report that a regulatory reporting message was not processed \t\t\t\tsuccessfully, and the reasons for that. DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). A type defining the basic content for a message sent to inform \t\t\t\tanother system that some exception has been detected in a regulatory reporting \t\t\t\tmessage.">
    [rootType]

    header ExceptionMessageHeader (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25).">
    reason Reason (0..*) <"An instance of the Reason type used to record the nature of any errors             associated with a message.">
    additionalData AdditionalData (0..1) <"Any string of additional data that may help the message processor, for             example in a rejection message this might contain a code value or the text of the             original request (within a CDATA section).">

type RegulatoryWithdrawal extends AddressedMessage: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Message used to request withdrawal from one or more \t\t\t\tjurisdictions. DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). A type defining the message used to request withdrawal from one or \t\t\t\tmore jurisdictions.">
    [rootType]

    onBehalfOf OnBehalfOf (0..4) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Indicates which party (or parties) (and accounts) a \t\t\t\t\t\t\t\ttrade or event is being processed for. Normally there will only be a \t\t\t\t\t\t\t\tmaximum of 2 parties, but in the case of a novation there could be a \t\t\t\t\t\t\t\ttransferor, transferee, remaining party, and other remaining party. \t\t\t\t\t\t\t\tAlso, in the context of a trade package there could be several \t\t\t\t\t\t\t\tparties for which limit check is requested, necessitating multiple \t\t\t\t\t\t\t\tonBehalfOf elements. Except for these cases, there should be no more \t\t\t\t\t\t\t\tthan two onBehalfOf references in a message.">
    tradeIdentifier PartyTradeIdentifier (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). identifies the affected trade">
    primaryAssetClass AssetClass (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). The asset class of the underlying \t\t\t\t\t\t\t\tproduct.">
    inapplicableRegulation InapplicableRegulation (1..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Indicates which regulation the trade is to withdrawn \t\t\t\t\t\t\t\tfrom. At least one child element must be \t\t\t\t\t\t\t\tselected.">
    withdrawalReason NormalizedString (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25).">
    fullyWithdrawn boolean (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Indicates if the trade is now fully withdrawn from \t\t\t\t\t\t\t\tall regulatory reports. This can be used by a trade repository to \t\t\t\t\t\t\t\tperform a consistency check. For instance, if \"fullyWithdrawn\" is \t\t\t\t\t\t\t\t\"true\" but the TR believes that the trade is still reportable to at \t\t\t\t\t\t\t\tleast one regulator, it could report an exception with the identity \t\t\t\t\t\t\t\tof that regulator. Or if \"fullyWithdrawn\" is false but the TR \t\t\t\t\t\t\t\tbelieves that the trade is no longer reportable to any regulator, \t\t\t\t\t\t\t\tthe TR should report that fact.">
    relatedParty RelatedParty (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25).">
    party Party (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). The supporting party definitions.">

type ESMAContractType:

    value Scheme (1..1)
    contractTypeScheme NonEmptyURI (0..1)

type ESMACreditDetails:

    seniority ESMACreditSeniority (0..1) <"A scheme-qualified code identifying the seniority classification assigned to the credit instrument for regulatory recordkeeping and reporting.">
    indexFactor NonNegativeDecimal (0..*) <"Specifies the non-negative factor applicable to a credit index in the transaction details provided for ESMA regulatory reporting.">

type ESMACreditSeniority:

    value Scheme (1..1)
    creditSeniorityScheme NonEmptyURI (0..1)

type ESMADeliveryType:

    value Scheme (1..1)
    deliveryTypeScheme NonEmptyURI (0..1)

type ESMAIndexIdentification:

    code ESMABenchmarkIndexCode (0..1) <"The ESMA benchmark index code used to identify the index in regulatory recordkeeping and trade reporting submissions.">
    name ESMAIndexName (0..1) <"The textual designation used to identify the relevant index for ESMA reporting in place of its benchmark index code.">

    condition Choice:
        one-of

type ESMAProductUnderlyer:

    instrumentId InstrumentId (0..*) <"A scheme-qualified short-form unique identifier for the security serving as the underlyer of the product reported to ESMA.">
    index ESMAIndexIdentification (0..1) <"Identifies the index serving as the underlying reference for the product in an ESMA regulatory record.">
    maturityDate zonedDateTime (0..1) <"Specifies the maturity date of the underlying instrument or index for identification in ESMA regulatory reporting.">

    condition Choice0:
        optional choice instrumentId, index

    condition Choice1:
        if instrumentId is absent and index is absent
        then maturityDate exists

type EventTimestamps: <" DEPRECATED. Not in use (RPTWG decision \t\t\t\t2024-12-12).">

    agreementDate zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2024-12-12). When the details of the event were \t\t\t\t\t\tagreed.">
    entryDateTime zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2024-12-12). When the agreed details where recorded.">
    executionDateTime zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2024-12-12). When the event was executed.">
    effectiveDate zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2024-12-12). When the event is actually effective from">

type InapplicableRegulation: <"Identifies a supervisory body, optionally qualified by one or more regulations, or an individual regulation, as inapplicable to the reported record, with an optional coded withdrawal reason.">

    supervisoryBody string (0..1) <"Identifies the supervisory authority associated with the regulations determined to be inapplicable for the relevant regulatory submission.">
    regulation RegulationName (0..*) <"Identifies a regulation determined to be inapplicable to the regulatory reporting submission, using the applicable regulation coding scheme.">
    withdrawalReasonCode ReasonCode (0..1) <"A machine-interpretable code specifying the reason for withdrawing the identified regulation or supervisory body’s regulations as applicable to the reported transaction.">

    condition Choice:
        if supervisoryBody is absent then regulation exists

type RegReportingCDE extends RegulatoryClassification: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2024-12-12).">

    buyerPartyReference PartyReference (0..1) <"Indicates the party this regulator considers to be the buyer">
    sellerPartyReference PartyReference (0..1) <"Indicates the party this regulator considers to be the seller.">
    finalContractualSettlementDate zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Unadjusted date as per the contract, by which all \t\t\t\t\t\t\t\ttransfer of cash or assets should take place and the counterparties \t\t\t\t\t\t\t\tshould no longer have any outstanding obligations to each other \t\t\t\t\t\t\t\tunder that contract. For products that may not have a final \t\t\t\t\t\t\t\tcontractual settlement date (eg American options), this data element \t\t\t\t\t\t\t\treflects the date by which the transfer of cash or asset would take \t\t\t\t\t\t\t\tplace if termination were to occur on the expiration \t\t\t\t\t\t\t\tdate.">
    earlyTerminationDate zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Effective date of the early termination (expiry) of \t\t\t\t\t\t\t\tthe reported transaction. This data element is applicable if the \t\t\t\t\t\t\t\ttermination of the transaction occurs prior to its maturity due to \t\t\t\t\t\t\t\tan ex-interim decision of a counterparty (or counterparties). \t\t\t\t\t\t\t\tExamples of early terminations (expiry) are: negotiated early \t\t\t\t\t\t\t\ttermination; early termination under an optional early termination \t\t\t\t\t\t\t\tprovision (\"mutual put\"); novation; offsetting (netting) \t\t\t\t\t\t\t\ttransaction; option exercise; compression; early termination clause \t\t\t\t\t\t\t\tspecified in the original contract which is a callable swap (bought \t\t\t\t\t\t\t\tembedded option); mutual credit break.">
    clearingStatus ClearingStatusValue (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). Indicator of whether the transaction has been \t\t\t\t\t\t\t\tcleared, or is intended to be cleared, by a central \t\t\t\t\t\t\t\tcounterparty.">
    confirmationStatus string (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2024-12-12). For new reportable transactions (as defined by the \t\t\t\t\t\t\t\tCPMI-IOSCO Technical Guidance: Harmonisation of the Unique \t\t\t\t\t\t\t\tTransaction Identifier), whether the legally binding terms of an OTC \t\t\t\t\t\t\t\tderivatives contract were documented and agreed upon (confirmed) or \t\t\t\t\t\t\t\tnot (unconfirmed). If documented and agreed, whether such \t\t\t\t\t\t\t\tconfirmation was done: - via a shared confirmation facility or \t\t\t\t\t\t\t\tplatform, or a private/bilateral electronic system (electronic); - \t\t\t\t\t\t\t\tvia a human-readable written document, such as fax, paper or \t\t\t\t\t\t\t\tmanually processed e-mails (non-electronic).">

type RegReportingPackageInfo:

    packageIdentifier IssuerTradeId (0..1) <"Identifies the regulatory reporting package using a two-part identifier assigned by an issuer, such as a USI.">
    pacakageWithNonReportableComponent boolean (0..1) <"Indicates whether the regulatory reporting package identified by the associated package identifier contains a component that is not reportable.">

