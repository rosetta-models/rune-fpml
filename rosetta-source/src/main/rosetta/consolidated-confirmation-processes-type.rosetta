type ConsentAcknowledgement extends EventRequestAcknowledgement: <"Recognizes the receipt and processing of a consent request. It confirms that the request for consent has been processed, and may include details about the original message, trade reference information, and involved parties and accounts.">
    [rootType]

type ConsentException extends Exception: <"Represents an exception or error related to a consent request. It provides details about the exception, including a header with error information, validation issues, and any correlation or sequence data, signaling problems encountered during processing.">
    [rootType]

type ConsentGranted extends ResponseMessage: <"Indicates that consent has been granted for the requested action. It includes the approval type, approver, party reference, approval ID, portfolio reference, event or information details, and credit limit information. It may also include details about the involved parties and accounts. A message indicating that the sender grants consent for the recipient to perform the requested action.">
    [rootType]

    ^type ApprovalType (0..1) <"The type of approval (e.g. \"pre-clearing credit\").">
    approver PersonId (0..1) <"The full name or identifiying ID of the relevant approver.">
