namespace fpml.consolidated.confirmation.processes : < "fpml definition" >
version "${project.version}"

import fpml.consolidated.asset.*
import fpml.consolidated.business.events.*
import fpml.consolidated.doc.*
import fpml.consolidated.msg.*
import fpml.consolidated.reg.^reporting.shared.*
import fpml.consolidated.shared.*

type RequestExecution extends CorrectableRequestMessage: <"Represents a request to execute a trading event or an option exercise. It includes the necessary details for the execution request, such as the underlying trading events or option exercise, along with related parties and accounts. A message requesting that an order be executed.">
    [rootType]

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    additionalEvent AdditionalEvent (0..1)
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if tradePackage exists
        then originatingEvent is absent
                and trade is absent
                and additionalEvent is absent
                and optionExercise is absent
        else if trade exists
        then tradePackage is absent
                and additionalEvent is absent
                and optionExercise is absent
        else if additionalEvent exists
        then tradePackage is absent
                and trade is absent
                and originatingEvent is absent
                and optionExercise is absent
        else if optionExercise exists
        then tradePackage is absent
                and trade is absent
                and additionalEvent is absent
                and originatingEvent is absent
        else False

type RequestExecutionRetracted extends NonCorrectableRequestMessage: <"Signals the retraction or withdrawal of a previously sent execution request. It indicates that the request to execute a trade or option exercise has been rescinded. The retraction may be associated with a change in trading events or option exercises, along with relevant parties and accounts. A message withdrawing a request that an order be executed.">
    [rootType]

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    additionalEvent AdditionalEvent (0..1)
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    party Party (0..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if trade exists
        then tradePackage is absent
                and additionalEvent is absent
                and optionExercise is absent
        else if additionalEvent exists
        then trade is absent
                and tradePackage is absent
                and originatingEvent is absent
                and optionExercise is absent
        else if optionExercise exists
        then trade is absent
                and additionalEvent is absent
                and tradePackage is absent
                and originatingEvent is absent
        else trade is absent
            and additionalEvent is absent
            and optionExercise is absent
            and originatingEvent is absent

type ExecutionNotification extends CorrectableRequestMessage: <"Notifies the execution of a trade or option exercise. It includes information about any amendments to the trade, additional events, collateralization details, and the involved parties and accounts. A message notifying a party that a trade execution has occurred. (Typically this is sent by an execution platform to a participant.)">
    [rootType]

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    amendment TradeAmendmentContent (0..1) <"Captures modifications made to a previously executed trade. This element is crucial for tracking post-trade amendments, ensuring that trade records remain accurate and up to date.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Represents an extra event that supplements the primary trading or post-trade events described within the message.">
    quote BasicQuotation (0..*) <"Pricing information for the trade.">
    collateralization RegulatoryReportingCollateralization (0..2) <"Collateralization block, that holds Regulator specific requirement about the trades\' collateralization, is added here to accommodate a technical implementation of SFTR. The change aligns with the established principle that the content in recordkeeping view is now also available in the confirmation view for both functional and technical reasons. The appropriate place for this information is \'regulatoryDisclosure\' and \'nonpublicExecutionReport\' messages in the Recordkeeping view.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if tradePackage exists
        then originatingEvent is absent
                and trade is absent
                and amendment is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if trade exists
        then tradePackage is absent
                and amendment is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if amendment exists
        then tradePackage is absent
                and trade is absent
                and originatingEvent is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if optionExercise exists
        then tradePackage is absent
                and trade is absent
                and amendment is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and additionalEvent is absent
        else if optionExpiry exists
        then tradePackage is absent
                and trade is absent
                and amendment is absent
                and optionExercise is absent
                and optionEvent is absent
                and originatingEvent is absent
                and additionalEvent is absent
        else if optionEvent exists
        then tradePackage is absent
                and trade is absent
                and amendment is absent
                and optionExercise is absent
                and optionExpiry is absent
                and originatingEvent is absent
                and additionalEvent is absent
        else if additionalEvent exists
        then tradePackage is absent
                and trade is absent
                and amendment is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
        else False

type ExecutionRetracted extends NonCorrectableRequestMessage: <"Indicates that a previously executed trade or option exercise has been retracted or reversed. It signals the cancellation of the execution and may contain details about the affected trading events or option exercises, along with relevant parties and accounts. A message retracting a notification to a party that a trade execution has occurred. (Typically this is sent by an execution platform to a participant.)">
    [rootType]

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    additionalEvent AdditionalEvent (0..1)
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    party Party (0..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if trade exists
        then tradePackage is absent
                and additionalEvent is absent
                and optionExercise is absent
        else if additionalEvent exists
        then trade is absent
                and tradePackage is absent
                and originatingEvent is absent
                and optionExercise is absent
        else if optionExercise exists
        then trade is absent
                and additionalEvent is absent
                and tradePackage is absent
                and originatingEvent is absent
        else trade is absent
            and additionalEvent is absent
            and optionExercise is absent
            and originatingEvent is absent

type ExecutionAcknowledgement extends EventRequestAcknowledgement: <"Recognizes the receipt of an event request, such as a trade or option exercise. It serves as confirmation that the request has been processed or received, potentially including details about the original message, trade references, and parties involved.">
    [rootType]

type ExecutionException extends Exception: <"Represents an exception or error related to an execution request. It contains a header with the exception message, validation details, and any optional correlation or sequence information. This element notifies the sender of issues or problems encountered during the processing of the request.">
    [rootType]

type ExecutionAdvice extends CorrectableRequestMessage: <"Provides advice or instructions regarding the execution of a trade, including details on the product type, trading events, post-trade events, and any associated amendments or option-related events. It also includes valuation information, collateralization details, and payment instructions, along with related parties and accounts. A message advising a third party that a trade execution has occurred.">
    [rootType]

    productType ProductType (0..1) <"Specifies the type of financial product associated with the execution advice. It provides a standardized classification for the product being executed, facilitating trade processing, regulatory reporting, and risk management.">
    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    change TradeChangeContent (0..1) <"Represents the change event associated with a trade.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Represents an extra event that supplements the primary trading or post-trade events described within the message.">
    quote BasicQuotation (0..*) <"Pricing information for the trade.">
    collateralization RegulatoryReportingCollateralization (0..2) <"Collateralization block, that holds Regulator specific requirement about the trades\' collateralization, is added here to accommodate a technical implementation of SFTR. The change aligns with the established principle that the content in recordkeeping view is now also available in the confirmation view for both functional and technical reasons. The appropriate place for this information is \'regulatoryDisclosure\' and \'nonpublicExecutionReport\' messages in the Recordkeeping view.">
    paymentDetails PaymentDetails (0..*) <"Details of the payments, like amount breakdowns, settlement information.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if tradePackage exists
        then originatingEvent is absent
                and trade is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if trade exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if amendment exists
        then increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if increase exists
        then terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if termination exists
        then novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if novation exists
        then terminatingEvent is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if withdrawal exists
        then terminatingEvent is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if observation exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if reset exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if change exists
        then reset is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if optionExercise exists
        then reset is absent
                and change is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if optionExpiry exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if optionEvent exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if additionalEvent exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
        else False

type ExecutionAdviceRetracted extends NonCorrectableRequestMessage: <"Signals the retraction or withdrawal of a previously sent execution advice. It indicates that the execution advice has been rescinded and includes details on any revised trading events, post-trade events, changes, or option-related events, along with any collateralization, payment details, and affected parties. A message that withdraws an advice to a third party that a trade execution has occurred.">
    [rootType]

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    change TradeChangeContent (0..1) <"Represents the change event associated with a trade.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Represents an extra event that supplements the primary trading or post-trade events described within the message.">
    collateralization RegulatoryReportingCollateralization (0..2) <"Captures collateral-related details associated with the retraction of an execution advice. This element is crucial in regulatory reporting, as it specifies the collateral posted for the trade, ensuring compliance with margining and risk management requirements.">
    paymentDetails PaymentDetails (0..*) <"Details of the payments, like amount breakdowns, settlement information.">
    party Party (0..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if trade exists
        then tradePackage is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if amendment exists
        then increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and tradePackage is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if increase exists
        then terminatingEvent is absent
