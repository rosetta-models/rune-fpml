            and optionEvent is absent
            and additionalEvent is absent
            and originatingEvent is absent
            and terminatingEvent is absent

type ExecutionAdviceAcknowledgement extends EventRequestAcknowledgement: <"Recognizes the receipt and processing of an execution advice request. It confirms that the request has been acknowledged, providing potential details about the original message, associated trade references, and parties involved.">
    [rootType]

type ExecutionAdviceException extends Exception: <"Represents an exception or error related to an execution advice. It includes a header with the exception message, validation details, and additional optional correlation or sequence information, notifying the sender of any issues encountered while processing the execution advice.">
    [rootType]

type MaturityNotification extends CorrectableRequestMessage: <"Alerts the parties involved about the maturity of a trade or an option. It includes information about the expiration or maturity of the option or trade, specifying the relevant option expiry or trade maturity details, and includes relevant parties and accounts for further processing. A message used to notify another party that a trade has matured. This can be used to report, for example, that a swap has passed its final payment and can be removed, or that an option has expired without being executed.">
    [rootType]

    optionExpiry OptionExpiryBase (0..1) <"Represents the expiration details of an option contract, including the date and time of expiry, and the trade identifier of the option.">
    tradeMaturity TradeMaturity (0..1) <"Provides details on when a trade reaches its contractual end, including the date of maturity and the trade identifier.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        required choice optionExpiry, tradeMaturity

type MaturityAcknowledgement extends EventRequestAcknowledgement: <"Recognizes the receipt and processing of a maturity notification. It confirms that the notification has been received and processed, possibly including information about the original message, trade references, and involved parties.">
    [rootType]

type MaturityException extends Exception: <"Represents an exception or error related to a maturity notification. It provides the exception details, including the header, validation issues, and any additional correlation or sequence information, alerting the sender to problems encountered during the maturity processing.">
    [rootType]

type RequestTradeReferenceInformationUpdate extends CorrectableRequestMessage: <"Requests an update to the trade reference information. It includes details about the trade reference and the involved parties and accounts. The request allows for corrections or updates to the trade details. Defines the structure for a message requesting information updates to a trade. The trade reference information should contain at least one trade identifier that the recipient is aware of.">
    [rootType]

    tradeReferenceInformation TradeReferenceInformation (1..1) <"Information about a trade.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

type RequestTradeReferenceInformationUpdateRetracted extends NonCorrectableRequestMessage: <"Indicates the retraction or withdrawal of a previously submitted trade reference information update request. It signals that the request for the update should no longer be processed, and it includes details about the trade reference and involved parties. Defines the structure for a message retracting a request to updated information about trade.">
    [rootType]

    tradeReferenceInformation TradeReferenceInformation (1..1) <"Information about a trade.">
    party Party (0..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

type TradeReferenceInformationUpdateAcknowledgement extends EventRequestAcknowledgement: <"Recognizes the receipt and processing of a trade reference information update request. It confirms that the update request has been acknowledged, and it may include details about the original message, trade reference information, and involved parties.">
    [rootType]

type TradeReferenceInformationUpdateException extends Exception: <"Represents an exception or error related to a trade reference information update request. It includes a header with exception details, validation issues, and any additional information, such as correlation or sequence data, alerting the sender to problems encountered while processing the request.">
    [rootType]

type TradeChangeAdvice extends CorrectableRequestMessage: <"Provides advice or instructions regarding changes to a trade. It includes details on the specific changes (e.g., amendments or adjustments to the trade), valuation information, collateralization, payment details, and related parties and accounts. Defines the structure for a message indicating that a trade is being changed due to a non-negotiated event.">
    [rootType]

    change TradeChangeContent (1..1) <"Describes the details of the change.">
    quote BasicQuotation (0..*) <"Pricing information for the trade.">
    paymentDetails PaymentDetails (0..*) <"Details of the payments, like amount breakdowns, settlement information.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

type TradeChangeAdviceRetracted extends NonCorrectableRequestMessage: <"Signals the retraction or withdrawal of a previously submitted trade change advice. It indicates that the trade change advice should no longer be processed and includes information about the trade identifiers, changes made to the trade, payment details, and parties involved. Defines the structure for a message retracting a prior change advice.">
    [rootType]

    tradeIdentifier PartyTradeIdentifier (1..*) <"The qualified identifiers of the subject trade.">
    change TradeChangeContent (0..1) <"Describes the details of the change being retracted.">
    paymentDetails PaymentDetails (0..*) <"Details of the payments, like amount breakdowns, settlement information.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

type TradeChangeAdviceAcknowledgement extends EventRequestAcknowledgement: <"Recognizes the receipt and processing of a trade change advice request. It confirms that the request for trade changes has been received and processed, and it may include details about the original message, trade reference information, and involved parties.">
    [rootType]

type TradeChangeAdviceException extends Exception: <"Represents an exception or error related to a trade change advice. It includes exception details, such as the header, validation issues, and any correlation or sequence information, alerting the sender to problems encountered during the trade change processing.">
    [rootType]

type RequestConsent extends CorrectableRequestMessage: <"Represents a request for consent, typically seeking approval for specific actions or decisions. It includes details about the requested action, the approval type, the approver, and the involved party references. The request may also include portfolio references, compression data, and trading/post-trade events or deClear options, along with any related valuations and parties and accounts. A message requesting that the sender be authorized by the recipient to peform an action.">
    [rootType]

    requestedAction RequestedAction (0..1) <"The reason the consent was requested.">
    ^type ApprovalType (0..1) <"The type of approval (e.g. \"pre-clearing credit\").">
    approver PersonId (0..1) <"The full name or identifiying ID of the relevant approver.">
    approvingPartyReference PartyReference (0..1) <"A pointer style reference to a party defined elsewhere in the document. The party referenced needs to approve the specified item (e.g. trade or allocation).">
    portfolioReference PortfolioReference (0..1) <"Provides the portfolio identification under which individual messages are grouped and may be acted upon collectively.">
    compressionActivity CompressionActivity (0..1) <"Compression information for the trade.">
    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    additionalEvent AdditionalEvent (0..1)
    deClear DeClear (0..1) <"A structure describing a declear event. The deClear event allows a firm to request that a trade be removed from clearing, or a clearing service to request consent for this, or to report that it has been done.">
    quote BasicQuotation (0..*) <"Pricing information for the trade.">
    party Party (1..*) <"A legal entity or a subdivision of a legal entity. Parties can perform multiple roles in a trade lifecycle. For example, the principal parties obligated to make payments from time to time during the term of the trade, but may include other parties involved in, or incidental to, the trade, such as parties acting in the role of novation transferor/transferee, broker, calculation agent, etc. In FpML roles are defined in multiple places within a document.">
    account Account (0..*) <"Optional account information used to precisely define the origination and destination of financial instruments.">

    condition Choice:
        if tradePackage exists
        then originatingEvent is absent
                and trade is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and additionalEvent is absent
                and deClear is absent
        else if trade exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and additionalEvent is absent
                and deClear is absent
        else if amendment exists
        then increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if increase exists
        then terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if termination exists
        then novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if novation exists
        then terminatingEvent is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if withdrawal exists
        then terminatingEvent is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if observation exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if reset exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and additionalEvent is absent
                and deClear is absent
        else if additionalEvent exists
        then reset is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and deClear is absent
        else if deClear exists
        then reset is absent
                and additionalEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
        else False

