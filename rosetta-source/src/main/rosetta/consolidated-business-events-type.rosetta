namespace fpml.consolidated.business.events : < "fpml definition" >
version "${project.version}"

import fpml.consolidated.asset.*
import fpml.consolidated.cd.*
import fpml.consolidated.com.*
import fpml.consolidated.doc.*
import fpml.consolidated.^enum.*
import fpml.consolidated.generic.*
import fpml.consolidated.shared.*

type BasketChange extends BasketChangeEvent: <"Describes a change due to change in composition of basket underlyer">
    [rootType]

type ChangeEvent extends AbstractEvent: <"Abstract substitutable place holder for specific change details. Abstract base type for non-negotiated trade change descriptions">
    [rootType]

type CreditChangeEvent extends CreditChangeEventBase: <"Describes a change due to a credit event. A structure indicating that a trade has changed due to a credit event, including both shared (by single name, index and basket) and index specific components.">
    [rootType]

    indexReferenceInformation CreditEventIndexReferenceInformation (0..1) <"A type defining the Credit Default Swap Index impacted by the credit event.">
    excludedReferenceEntity ReferenceInformation (0..1) <"The corporate or sovereign entity (and, optionally, associated obligations) in a basket impacted by the credit event.">

    condition Choice:
        optional choice indexReferenceInformation, excludedReferenceEntity

type CorporateAction extends CorporateActionEvent: <"Describes a change due to a corporate action">
    [rootType]

type IndexChange extends ChangeEvent: <"Describes a change due to an index component being adjusted. A structure describing the effect of a change to an index.">
    [rootType]

    indexFactor number (0..1) <"Represents the index version factor or percentage as an absolute decimal value between 0 and 1. This factor, when multiplied by the original notional amount, determines the adjusted notional amount following an index change. This structure allows for precise calculation of the impact of index adjustments on financial instruments.">
    factoredCalculationAmount Money (0..1) <"Represents the monetary value obtained by applying the specified indexFactor to the original calculation amount. This adjusted amount reflects the impact of the index change on the financial instrument\'s value.">

type AbstractEvent: <"Abstract base type for all events.">

    eventIdentifier BusinessEventIdentifier (0..*) <"Serves to uniquely identify a business event. This structure allows for precise identification and tracking of events within financial transactions.">

type ActionOnExpiration: <"Defines the action to be taken when an option expires. It describes how an option\'s exercise amount is handled upon expiration, as well as allowing for different types of actions, such as exercising in notional amounts, options, or units, and includes the possibility of specifying amounts for each. It also accommodates multiple exercise specifications, such as whether the action involves a full exercise or partial exercise, and it allows for indicating the remaining notional amount, outstanding options, or units.">

    exerciseAction ExerciseActionEnum (0..1) <"Indicates the type of exercise action performed for the option, with possible values of \"FullExercise\", \"PartialExercise\", or \"Abandon\".">
    expiry boolean (0..1) <"A boolean indicating whether the option has expired, with true for expired and false for not expired.">
    fullExercise boolean (0..1) <"A boolean indicating whether the option was fully exercised (true) or not (false).">
    exerciseInNotionalAmount Money (0..1) <"Specifies the fixed amount by which the option should be exercised expressed as notional amount.">
    outstandingNotionalAmount Money (0..1) <"Specifies the Notional amount after the Change">
    exerciseInNumberOfOptions number (0..1) <"Specifies the fixed amount by which the option should be exercised expressed as number of options.">
    outstandingNumberOfOptions number (0..1) <"Specifies the Number of Options after the Change.">
    exerciseInNumberOfUnits number (0..1) <"Specifies the fixed amount by which the option should be exercised express as number of units.">
    outstandingNumberOfUnits number (0..1) <"Specifies the Number of Units">
    specifiedExercise OptionExerciseAmounts (0..*) <"Specifies the Number of Units">

    condition Choice:
        if exerciseAction exists
        then expiry is absent
                and fullExercise is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and specifiedExercise is absent
        else if expiry exists
        then fullExercise is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and specifiedExercise is absent
        else if fullExercise exists
        then exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and specifiedExercise is absent
        else if specifiedExercise exists
        then exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
        else exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent

type AdditionalEvent extends AbstractEvent: <"Abstract base type for an extension/substitution point to customize FpML and add additional events.">

type AmountRef: <"A type defining a nominal amount with a reference.">

    amount PositiveDecimal (1..1) <"A positive decimal number representing a monetary value. It is used within the AmountRef complex type to specify the amount of money involved in a financial transaction. This structure allows for clear representation of monetary amounts and their references in financial documents.">
    amountReference AmountReference (0..1) <"A reference to another amount specified elsewhere in the document, using the AmountReference type. This structure allows for the reuse of amount definitions within a financial document, promoting consistency and reducing redundancy.">

type BasketChangeEvent extends ChangeEvent: <"A structure indicating that the basket underlyer of the trade has changed due to client trading activity">

type BusinessEventIdentifier: <"A type defining an event identifier issued by the indicated party.">

    id string (0..1)
    partyReference PartyReference (1..1) <"Reference to a party.">
    accountReference AccountReference (0..1) <"Reference to an account.">
    eventId EventId (1..1) <"A unique identifier assigned by a party to a post-trade event. Its structure allows for the precise identification and referencing of events within financial transactions.">

type ResetCalculationDetails: <"A cashflow component with optional calculation details that explain how the reset value was computed.">

    observation Observation (0..*) <"The underlyer rate or price observation(s) used to compute the amount of this cashflow component.">
    calculationElements ResetCalculationElements (0..1) <"The calculation details used to compute the reset rate.">

type ResetCalculationElements: <"Defines the components used to calculate the reset rate for a financial instrument.">

    notional CashflowNotional (0..1) <"Identifies the notional in effect for this calculation period.">
    calculatedRate CashflowFixing (0..1) <"The computed rate(s) or price(s) used to calculate the amount of this reset. These computed rates or prices may include averaging and/or various types of rate treatment rules.">
    calculationPeriod ResetCalculationPeriod (0..1) <"The period details for calculation/accrual periods that comprise this reset.">

type ResetCalculationPeriod: <"The period calculation details for a calculation/accrual period. This will include information about the dates and duration of the accrual period, the rate fixing(s), the notional in effect, and the amount of the accrual.">

    adjustedStartDate zonedDateTime (0..1) <"Date that defines the beginning of the calculation period.">
    adjustedEndDate zonedDateTime (0..1) <"Date that defines the end of the calculation period.">
    numberOfDays int(min: 1) (0..1) <"The number of days from the adjusted effective / start date to the adjusted termination / end date calculated in accordance with the applicable day count fraction.">
    dayCountFraction DayCountFraction (0..1) <"The specification for how the number of days between two dates is calculated for purposes of calculation of a fixed or floating payment amount and the basis for how many days are assumed to be in a year. Day Count Fraction is an ISDA term. The equivalent AFB (Association Francaise de Banques) term is Calculation Basis.">
    dayCountYearFraction number (0..1) <"The year fraction value of the calculation period, result of applying the ISDA rules for day count fraction defined in the ISDA Annex.">

type CashflowFixing: <"Details of the computation of a computed rate or price used to calculate the amount of a cashflow component. This computed rate or price may include averaging and/or various types of rate treatment rules. The details include all of the observations, the calculation parameters, and the resulting value.">

    id string (0..1)
    observationReference CashflowObservationReference (0..*) <"Reference to the observation details of a particular rate observation.">
    calculatedValue number (0..1) <"The value computed based on averaging the underlying observation and applying any spreads, multipliers, and cap and floors values. average or treated value computed based on the underlyer observations, following the calculation rules.">
    multiplier number (0..1) <"A rate multiplier to apply to the floating rate. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one).">
    spread number (0..1) <"The ISDA Spread, if any, which applies for the calculation period. It also defines spread as price. The spread is a per annum rate, expressed as a decimal. For purposes of determining a calculation period amount, if positive the spread will be added to the floating rate and if negative the spread will be subtracted from the floating rate. A positive 10 basis point (0.1%) spread would be represented as 0.001.">
    capValue Strike (0..*) <"The cap rate or price, if any, which applies to the floating rate for the calculation period. The cap rate (strike) is only required where the floating rate on a swap stream is capped at a certain strike level. The cap rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A cap rate of 5% would be represented as 0.05.">
    floorValue Strike (0..*) <"The floor rate or price, if any, which applies to the floating rate for the calculation period. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. The floor rate of 5% would be represented as 0.05.">
    negativeInterestRate boolean (0..1) <"Flag to indicate if negative interest rate is applied.">
    rounding Rounding (0..1) <"Rounding direction and precision for price values.">

type CashflowObservationReference extends Reference: <"Reference to a cash flow observation component.">

    href string (1..1)

type ClearingInstructions: <"Specifies instructions related to the clearing process of a financial transaction. It provides the necessary details to facilitate the clearing process in financial transactions.">

    requestedClearingAction RequestedClearingAction (0..1) <"Specifies the action a party requests regarding the clearing of a trade.">
    requestedClearingOrganizationPartyReference PartyReference (0..1) <"A pointer to a specific party defined elsewhere in the document, identifying the clearing organization that is requested to handle the clearing process for the associated trade. By referencing the clearing organization in this manner, the element facilitates clear and precise instructions within the clearing process.">

type CorporateActionEvent extends ChangeEvent: <"A structure indicating that a trade has changed due to a corporate action">

    ^type CorporateActionType (0..1) <"Specifies the nature of a corporate action that has occurred. This structure allows for the classification of corporate actions, such as mergers, acquisitions, or stock splits, by referencing a specific coding scheme.">

type CorporateActionType: <"A type that describes what type of corporate action occurred.">

    value Scheme (1..1)
    corporateActionScheme NonEmptyURI (0..1)

type CreditChangeEventBase extends ChangeEvent: <"A structure indicating that a trade has changed due to a credit event and containing only components shared by single name, index and basket.">

    creditEventType CreditEventType (0..1) <"Specifies the type of credit event taking place.">
    eventDeterminationDate zonedDateTime (0..1) <"The date at which a Credit Event Resolution Request Date (CERD) or Notice Delivery Date occurs.">
    auctionDate zonedDateTime (0..1) <"The date on which the auction is scheduled to occur.">
    settlementMethod CashOrPhysicalSettlementEnum (0..1) <"Specifies whether the process is to be physically settled or cash settled.">
    settlementDate zonedDateTime (0..1) <"The date on which settlement is scheduled to occur.">
    finalPrice number (0..1) <"The final price resulting from the auction.">
    recoveryPercent number (0..1) <"The percentage of the original value of the asset affected by the credit event that can be recovered.">
    publiclyAvailableInformation Resource (0..*) <"A public information source, e.g. a particular newspaper or electronic news service, that may publish relevant information used in the determination of whether or not a credit event has occurred.">

type EventId: <"A post-trade event reference identifier allocated by a party. FpML does not define the domain values associated with this element. Note that the domain values for this element are not strictly an enumerated list.">

    value NonEmptyScheme (1..1)
    eventIdScheme NonEmptyURI (0..1)
    id string (0..1)

type EventTaxonomy: <"DEPRECATED. Not in use (RPTWG decision 2025-09-25).">

    value NonEmptyScheme (1..1)
    eventTaxonomyScheme NonEmptyURI (0..1) <"DEPRECATED. Not in use (RPTWG decision 2025-09-25).">

type EventType: <"Represents a code that identifies the type of event occurring within a financial transaction. Its structure allows for the classification of events using a standardized coding scheme, facilitating consistent reporting and processing of various event types in financial transactions.">

    value NonEmptyScheme (1..1)
    eventTypeScheme NonEmptyURI (0..1)

type KnockOutRateObservation extends TriggerRateObservation: <"Describes an observation that caused a barrier knock out to trigger">

    rebatePayment NonNegativePayment (0..1) <"Any rebate payable as a result of the knock out">

type MoneyRef extends PositiveMoney: <"A type defining a currency amount with a reference.">

    notionalReference NotionalReference (0..1) <"A pointer style reference to the associated notional schedule defined elsewhere in the document.">

type NoTouchLowerBarrierObservation: <"Represents the observation details for a no-touch option\'s lower barrier. It allows for specifying either a trigger rate with associated currency pair and minimum observed rate, or a trigger price with minimum observed price, to detail the conditions under which the barrier event is assessed.">

    triggerRate number (0..1) <"The rate value (level) which was attained/breached, in order to trigger the barrier event.">
    quotedCurrencyPair QuotedCurrencyPair (0..1) <"Defines the currency pair and quote basis for an FX rate.">
    minimumObservedRate ObservedRate (0..1) <"The minimum value observed during the condition period.">
    triggerPrice PositiveMoney (0..1) <"The price value (level) which was attained/breached, in order to trigger the barrier event.">
    minimumObservedPrice ObservedPrice (0..1) <"The minimum value observed during the condition period">

    condition Choice:
        triggerPrice is absent and minimumObservedPrice is absent
            or triggerRate is absent
                and quotedCurrencyPair is absent
                and minimumObservedRate is absent

type NoTouchRateObservation: <"Defines the parameters for observing rates in a no-touch option. It includes optional elements for specifying the observation period, and allows for the definition of lower and upper barriers. Additionally, it provides options to specify exercise details. The structure is designed to capture the necessary information for processing no-touch options within the FpML framework.">

    observationStartDate zonedDateTime (0..1) <"Define the beginning period during which the underlying rate or price is monitored to determine if it breaches the specified barriers. The observationStartDate marks the beginning of this monitoring period, while the observationEndDate signifies its conclusion. This date is crucial for assessing the occurrence of barrier events in no-touch options.">
    observationEndDate zonedDateTime (0..1) <"Define the end of the period during which the underlying rate or price is monitored to determine if it breaches the specified barriers. This date is crucial for assessing the occurrence of barrier events in no-touch options.">
    lowerBarrier NoTouchLowerBarrierObservation (0..1) <"Defines the thresholds that, if breached, determine the outcome of a no-touch option. In this case, the lowerBarrier specifies the lower price or rate limit. If the underlying asset\'s price or rate crosses this limit during the observation period, the no-touch condition is violated, affecting the option\'s payoff.">
    upperBarrier NoTouchUpperBarrierObservation (0..1) <"The upper trigger level of a double no-touch observation, together with the highest rate or price observed over the observation period.">
    exerciseSide ExerciseSideEnum (0..1) <"Specifies which party has the right to exercise the option. It can take values such as \"Put\" or \"Call\", indicating the nature of the option, or \"Payer\" or \"Receiver\", specifying the role of the party in the transaction. This enumeration is particularly relevant in scenarios like straddle options, where it\'s necessary to define which side—paying or receiving—is being exercised.">
    settlementType SettlementTypeEnum (0..1) <"Specifies the method by which a transaction is settled upon exercise. It can take the following values: {\"Cash\", \"Physical\", \"Election\", \"CashOrPhysical\"}.">
    cashSettlement SimplePayment (0..1) <"Defines that the financial instrument is cash settled upon exercise. It specifies a straightforward payment arrangement between parties. This includes details such as the payer and receiver, the payment amount, and the payment date. This field is essential for specifying the settlement methods in derivative contracts, particularly in the context of no-touch options, where the instrument settles based on the underlying asset\'s price movement relative to predefined barriers.">
    physicalSettlement PhysicalSettlement (0..1) <"Defines that the financial instrument is physically settled upon exercise. It outlines the terms for the physical delivery of the underlying asset. This can include references to resulting trade identifiers, resulting trades, or specific product details. This field is essential for specifying the settlement methods in derivative contracts, particularly in the context of no-touch options, where the instrument settles based on the underlying asset\'s price movement relative to predefined barriers.">
    payment NonNegativePayment (0..1) <"Represents an optional payment associated with the observation.">
    clearingInstructions ClearingInstructions (0..1) <"Specifies instructions for how physical settlement should be executed when the option is exercised.">
    isExercisable boolean (0..1) <"If the touch or no touch event hasn\'t generated an exercise, then we specify whether the option is exercisable or not.">

    condition Choice0:
        isExercisable is absent
            or exerciseSide is absent
                and payment is absent
                and clearingInstructions is absent

    condition Choice1:
        optional choice settlementType, cashSettlement, physicalSettlement, isExercisable

type NoTouchUpperBarrierObservation: <"Designed to capture details about the upper barrier observation in a no-touch option.">

    triggerRate number (0..1) <"The rate value (level) which was attained/breached, in order to trigger the barrier event.">
    quotedCurrencyPair QuotedCurrencyPair (0..1) <"Defines the currency pair and quote basis for an FX rate.">
    maximumObservedRate ObservedRate (0..1) <"The maximum value observed during the condition period">
    triggerPrice PositiveMoney (0..1) <"The price value (level) which was attained/breached, in order to trigger the barrier event.">
    maximumObservedPrice ObservedPrice (0..1) <"The maximum value observed during the condition period">

    condition Choice:
        triggerPrice is absent and maximumObservedPrice is absent
            or triggerRate is absent
                and quotedCurrencyPair is absent
                and maximumObservedRate is absent

type Observation: <"Represents individual observations of an underlying rate or price, which are utilized in calculating cashflow components. It comprises two optional elements, observationReference and weight. This structure allows for the detailed specification of each observation and its contribution to financial computations.">

    observationReference ObservationReference (0..1) <"An optional component that serves as a pointer to a specific observation instance. This reference facilitates the identification and retrieval of particular observation data within a financial document.">
    weight number (0..1) <"An optional decimal value that assigns significance to the associated observation. It is used as a multiplier to adjust the impact of the observation when calculating weighted averages.">

type ObservationEvent extends AbstractEvent: <"An event in which a specific value is observed or recorded at a particular date and time, often as part of a financial calculation or trigger condition. Its structure allows for detailed recording of market observations, including the date, time, nature of the rate, the observed value, and its source.">

    date zonedDateTime (1..1) <"Date of observation.">
    time TimeZone (0..1) <"The observation time, with a possible indication of the timezone dimension.">
    side QuotationRateTypeEnum (0..1) <"The side (bid/mid/ask) of the observation, when applicable.">
    observedValue number (1..1) <"The observation value.">
    source ObservationSource (0..1) <"The observation source.">

type ObservationSource: <"The observation source can be composed of an curve and/or and information source.">

    informationSource InformationSource (0..1) <"The source of the observation.">
    underlyer TradeUnderlyer2 (0..1) <"Represents the underlying asset, index, or reference price whose rate or price is observed to determine the value of a cashflow or other financial calculation. It provides a flexible structure to define various types of underlyers, including floating rates, fixed rates, exchange rates, underlying assets, currency pairs, reference entities, indices, and commodity products. This element ensures clarity and precision in transparency reporting and other financial workflows.">

type ObservedPrice: <"Represents a recorded price observation relevant to a financial transaction. It is used to record and report observed prices for financial instruments, commodities, or other assets, ensuring accuracy and traceability in pricing data. Its structure allows for detailed documentation of price observations, including their values, timestamps, and origins.">

    price NonNegativeMoney (0..1) <"The observed rate value which triggered the barrier event.">
    date zonedDateTime (0..1) <"The date when the rate was observed.">
    time time (0..1) <"The time when the rate ws observed.">
    informationSource InformationSource (0..1) <"The source of the observation.">

type ObservedRate: <"Represents a recorded interest rate observation pertinent to a financial transaction. This structure allows for detailed documentation of observed rates, including their values, timestamps, and origins.">

    rate number (0..1) <"The observed rate value which triggered the barrier event.">
    date zonedDateTime (0..1) <"The date when the rate was observed.">
    time time (0..1) <"The time when the rate ws observed.">
    informationSource InformationSource (0..1) <"The source of the observation.">

type ObservationReference extends AbstractEvent: <"Reference to the observation details of a particular rate observation.">

type OptionEvent extends AbstractEvent: <"Represents occurrences affecting an option\'s status. It captures the nature of the event through elements like knockIn, knockOut, touch, or noTouch, each corresponding to specific option event types. This structure ensures comprehensive documentation of option-related events within the FpML framework.">

    originalTrade Trade (0..1) <"Fully describes the original trade (prior to the exercise).">
    tradeIdentifier PartyTradeIdentifier (0..*) <"Identified the trade to which the option event applies.">
    knockIn TriggerRateObservation (0..1) <"A structure describing a barrier knock in event">
    knockOut KnockOutRateObservation (0..1) <"A structure describing a barrier knock out event">
    touch TouchRateObservation (0..2) <"A structure describing a touch event">
    noTouch NoTouchRateObservation (0..1) <"A structure describing the outcome of an option having no touch events">

    condition Choice0:
        optional choice originalTrade, tradeIdentifier

    condition Choice1:
        optional choice knockIn, knockOut, touch, noTouch

type OptionExercise extends AbstractEvent: <"A structure describing an option exercise. The OptionExercise type supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">

    optionSeller PartyReference (0..1) <"The party responsible for selling or writing the option contract. Its structure ensures clear identification of the option seller within the trade, facilitating accurate contract processing and risk management.">
    optionBuyer PartyReference (0..1) <"The party purchasing or holding the option contract. Its structure ensures proper identification of the option buyer, enabling accurate trade processing and risk management in the context of the option agreement.">
    originalTrade Trade (0..1) <"Fully describes the original trade (prior to the exercise).">
    tradeIdentifier PartyTradeIdentifier (0..*) <"Represents identifiers for the trades involved in an option exercise event. It can include multiple identifiers, each linked to a specific trade. This element helps to track and link the trades connected to the exercise, whether it\'s a partial or full exercise, and ensures proper identification and processing of the associated trades.">
    exerciseDate zonedDateTime (0..1) <"Specifies the date on which the option exercise takes place. It is defined using the xsd:date type and indicates the specific calendar day the option will be exercised.">
    exerciseTime time (0..1) <"Specifies the exact time of day when the option exercise occurs, using the xsd:time type.">
    exerciseTiming ExerciseTimingEnum (0..1) <"Specifies when the option will be exercised. It is an enumeration with two possible values: \"Immediate\" and \"OnExpiration.\" \"Immediate\" indicates that the option will be exercised right away, while \"OnExpiration\" means the option will be exercised at its expiration date.">
    exerciseAction ExerciseActionEnum (0..1) <"Indicates the type of exercise action performed for the option, with possible values of \"FullExercise\", \"PartialExercise\", or \"Abandon\".">
    expiry boolean (0..1) <"A boolean indicating whether the option has expired, with true for expired and false for not expired.">
    fullExercise boolean (0..1) <"A boolean indicating whether the option was fully exercised (true) or not (false).">
    exerciseInNotionalAmount Money (0..1) <"Specifies the fixed amount by which the option should be exercised expressed as notional amount.">
    outstandingNotionalAmount Money (0..1) <"Specifies the Notional amount after the Change">
    exerciseInNumberOfOptions number (0..1) <"Specifies the fixed amount by which the option should be exercised expressed as number of options.">
    outstandingNumberOfOptions number (0..1) <"Specifies the Number of Options after the Change.">
    exerciseInNumberOfUnits number (0..1) <"Specifies the fixed amount by which the option should be exercised express as number of units.">
    outstandingNumberOfUnits number (0..1) <"Specifies the Number of Units">
    specifiedExercise OptionExerciseAmounts (0..*) <"Specifies the Number of Units">
    exerciseSide ExerciseSideEnum (0..1) <"Specifies the side of the option exercise, and can take two possible sets of values: either \"Put\" or \"Call\" (indicating the type of option), or \"Payer\" or \"Receiver\" (indicating the role in the transaction).">
    settlementType SettlementTypeEnum (0..1) <"Specifies the type of settlement for the option exercise. The possible values are \"Cash\" (settling with cash), \"Physical\" (settling with the underlying asset), \"Election\" (giving the option holder the choice between cash or physical settlement), or \"CashOrPhysical\" (allowing either cash or physical settlement without a decision).">
    cashSettlement SimplePayment (0..1) <"Represents a cash settlement for the option exercise. It contains details such as the payer/receiver, payment amount, and payment date, specifying the conditions under which cash is paid for the settlement.">
    physicalSettlement PhysicalSettlement (0..1) <"Represents a physical settlement for the option exercise. It involves either referencing a resulting trade identifier, a specific trade, or the underlying product, outlining the asset or process through which physical settlement will occur.">
    payment NonNegativePayment (0..1) <"Represents a payment associated with the option exercise. It contains details of the payment amount, ensuring that only non-negative values are accepted. This is typically used to indicate the monetary aspect of the settlement or exercise process.">
    clearingInstructions ClearingInstructions (0..1) <"Provides instructions for the clearing of the option exercise. These instructions ensure that the clearing process is carried out according to specified requirements.">

    condition Choice0:
        exerciseTiming is absent or exerciseDate is absent and exerciseTime is absent

    condition Choice1:
        optional choice settlementType, cashSettlement, physicalSettlement

    condition Choice2:
        optional choice originalTrade, tradeIdentifier

    condition Choice3:
        if exerciseAction exists
        then expiry is absent
                and fullExercise is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and specifiedExercise is absent
        else if expiry exists
        then fullExercise is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and specifiedExercise is absent
        else if fullExercise exists
        then exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and specifiedExercise is absent
        else if specifiedExercise exists
        then exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
        else exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent

type OptionExerciseAmounts: <"Specifies the amounts involved in the exercise of an option. It provides multiple ways to express exercised and outstanding amounts, allowing flexibility based on notional amounts, schedules, number of options, or number of units.">

    notionalReference NotionalReference (0..1) <"Provides a reference to a notional amount associated with the option contract. By linking to a Notional entity, this element allows for clear identification and tracking of the notional value used in the exercise calculation, ensuring consistency across related financial transactions.">
    exerciseInNotionalAmount Money (0..1) <"Specifies the fixed amount by which the option should be exercised expressed as notional amount.">
    outstandingNotionalAmount Money (0..1) <"Specifies the Notional amount after the Change">
    notionalScheduleReference NotionalReference (0..1) <"An optional reference to a notional schedule associated with the option contract. It provides a link to a predefined notional schedule elsewhere in the FpML document. Additionally, this element is used when the option exercise involves a scheduled notional amount instead of a fixed value, allowing for dynamic adjustments over time.">
    exerciseInNotionalSchedule NonNegativeAmountSchedule (0..1) <"Specifies the amount by which the option should be exercised expressed as notional schedule.">
    outstandingNotionalSchedule NonNegativeAmountSchedule (0..1) <"Specifies the Notional schedule after the Change">
    numberOfOptionsReference NumberOfOptionsReference (0..1) <"An optional reference to a predefined number of options related to the exercise. This reference ensures consistency in identifying the number of options involved in the exercise event, particularly in cases where multiple option contracts exist.">
    exerciseInNumberOfOptions number (0..1) <"Specifies the fixed amount by which the option should be exercised expressed as number of options.">
    outstandingNumberOfOptions number (0..1) <"Specifies the Number of Options after the Change.">
    numberOfUnitsReference NumberOfUnitsReference (0..1) <"An optional reference to a predefined number of units related to the option exercise. This element is relevant when the exercise is defined in terms of units (e.g., shares, barrels, or other underlying assets), ensuring clear identification and alignment with the overall contract structure.">
    exerciseInNumberOfUnits number (0..1) <"Specifies the fixed amount by which the option should be exercised express as number of units.">
    outstandingNumberOfUnits number (0..1) <"Specifies the Number of Units">

    condition Choice:
        notionalScheduleReference is absent
                and exerciseInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and numberOfOptionsReference is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and numberOfUnitsReference is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or notionalReference is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and numberOfOptionsReference is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and numberOfUnitsReference is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or notionalReference is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and notionalScheduleReference is absent
                and exerciseInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and numberOfUnitsReference is absent
                and exerciseInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
            or notionalReference is absent
                and exerciseInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and notionalScheduleReference is absent
                and exerciseInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and numberOfOptionsReference is absent
                and exerciseInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent

type OptionExpiry extends AbstractEvent: <"A structure describing an option expiring (i.e. passing its last exercise time and becoming worthless.)">

    originalTrade Trade (0..1) <"Fully describes the original trade (prior to the exercise).">
    tradeIdentifier PartyTradeIdentifier (0..*) <"Associates an expired option contract with one or more trade identifiers.">
    date zonedDateTime (0..1) <"Specifies the calendar date on which the option contract reaches its expiration. This marks the last day on which the option holder can exercise their rights under the contract. It is defined as an xsd:date, ensuring a standardized format (YYYY-MM-DD).">
    time time (0..1) <"Specifies the precise time on the expiration date when the option expires. It is defined as an xsd:time, capturing the exact moment in hours, minutes, and seconds when the option can no longer be exercised.">
    exerciseProcedure ExerciseProcedureOption (0..1) <"Specifies how the option can be exercised before expiration. It can either be manualExercise, requiring the holder to actively notify their intent to exercise, or automaticExercise, where the option is exercised automatically if it is in the money at expiration.">
    actionOnExpiration ActionOnExpiration (0..1) <"Defines what happens when the option reaches expiration, detailing whether it is exercised fully, partially, or expires worthless.">

    condition Choice:
        optional choice originalTrade, tradeIdentifier

type PhysicalSettlement: <"A structure that describes how an option settles into a physical trade.">

    resultingTradeIdentifier PartyTradeIdentifier (0..1) <"The ID of the trade that resulted from the physical settlement.">
    resultingTrade Trade (0..1) <"The trade that resulted from the physical settlement.">
    product Product (0..1) <"Represents an abstract financial product involved in a physical settlement. It serves as a placeholder for specific product types, allowing for flexibility in defining the underlying asset or contract being physically settled.">

    condition Choice:
        one-of

type RequestedClearingAction: <"A type that describes whether a trade is to be cleared.">

    value Scheme (1..1)
    requestedClearingActionScheme NonEmptyURI (0..1)

type RequestedWithdrawalAction: <"A type that describes what the requester would like to see done to implement the withdrawal, e.g. ExpungeRecords, RetainRecords.">

    value Scheme (1..1)
    requestedWithdrawalActionScheme NonEmptyURI (0..1)

type ResetEvent extends AbstractEvent: <"An event in which the floating rate of a financial contract is determined based on market conditions at a specific reset date. It extends the AbstractEvent type and includes key details such as the associated trade reference, leg identifiers, reset date, determined rate, and optional calculation details.">

    tradeReference PartyTradeIdentifiers (0..1) <"A container since an individual trade can be referenced by two or more different partyTradeIdentifier elements - each allocated by a different party.">
    legIdentifier LegIdentifier (0..*) <"Version aware identification of this leg.">
    date RequiredIdentifierDate (0..1) <"Date of reset.">
    resetValue IdentifiedRate (0..1) <"Value of reset.">
    calculationDetails ResetCalculationDetails (0..1) <"The set of calculations that comprise this reset value.">

type TerminatingEvent: <"A type that describes why a trade terminated.">

    value Scheme (1..1)
    terminatingEventScheme NonEmptyURI (0..1)

type TradeAmendmentContent extends AbstractEvent: <"A structure describing a negotiated amendment.">

    trade Trade (1..1) <"A full description of the amended trade (i.e. the trade after the amendment).">
    agreementDate zonedDateTime (0..1) <"The date on which the change was agreed.">
    executionDateTime ExecutionDateTime (0..1) <"The date and time at which the negotiated change to the terms of the original contract was agreed, such as via telephone or electronic trading system (i.e., agreement date/time).">
    effectiveDate zonedDateTime (0..1) <"The date on which the change become effective.">
    notionalChange NotionalChangeEnum (0..1) <"Indication as to whether the transaction is an increase or decrease of notional of a derivative contract. Only applies when there is change in notional for a derivative contract">
    changeInNotional MoneyRef (0..*) <"The change in notional amount for a prior report as a result of this event. The current notional will be reported in the trade itself. This corresponds to MiFIR Nominal or Monetary amount values; these can be distinguished by the esmaNotionalType indicator.">
    changeInNumberOfOptions AmountRef (0..*) <"The change in nominal amount from a prior report as a result of this event. The current number of options will be reported in the trade itself. This corresponds to the MiFIR \"units\" value.">
    changeInQuantity UnitQuantityRef (0..*) <"The change in quantity(s) from a prior report as a result of this event. The current quantity will be reported in the trade itself. This corresponds to the MiFIR \"units\" value.">
    payment Payment (0..*) <"Describes a payment made in settlement of the change. Normally there will be a single fee, but there could be additional payments such as principal exchanges resulting from the termination.">

    condition Choice:
        optional choice changeInNotional, changeInNumberOfOptions, changeInQuantity

type TradeChangeBase extends AbstractEvent: <"A structure describing a trade change.">

    tradeIdentifier PartyTradeIdentifier (0..*) <"Uniquely identifies a trade involved in a modification event. It captures references to trades affected by changes, including allocations, resulting trades, block trades, and originating trades.">
    originalTrade Trade (0..1) <"The trade as it existed before the modification event. It retains the original terms, parties, and economic details prior to any amendments, novations, or other changes.">
    resultingTrade Trade (0..1) <"Captures the trade after the modification event has been applied. It reflects any updates or adjustments made, such as changes in counterparties, notional amounts, or settlement terms. If no new trade is created as a result of the modification, this element may be omitted.">
    agreementDate zonedDateTime (0..1) <"The date on which the change was agreed.">
    executionDateTime ExecutionDateTime (0..1) <"The date and time at which the negotiated change to the terms of the original contract was agreed, such as via telephone or electronic trading system (i.e., agreement date/time).">
    effectiveDate zonedDateTime (0..1) <"The date on which the change become effective.">
    payment Payment (0..*) <"Describes a payment made in settlement of the change. Normally there will be a single fee, but there could be additional payments such as principal exchanges resulting from the termination.">

    condition Choice:
        optional choice tradeIdentifier, originalTrade

type TradeChangeContent: <"A structure describing a non-negotiated trade resulting from a market event.">

    oldTradeIdentifier PartyTradeIdentifier (0..1) <"The original qualified trade identifier.">
    oldTrade Trade (0..1) <"The original trade details.">
    trade Trade (0..1) <"A full description of the amended trade.">
    effectiveDate zonedDateTime (0..1) <"The date on which the change become effective">
    changeEvent ChangeEvent (0..1) <"Substitution point for types of change">
    payment Payment (0..*) <"Describes a payment made in settlement of the change.">

    condition Choice:
        optional choice oldTradeIdentifier, oldTrade

type TradeLegPriceChange: <"A structure describing a change to the size of a single leg or stream of a trade.">

    priceReference Reference (0..1) <"Provides a reference to an external price or pricing source used to determine the trade leg\'s valuation before or after the change. It ensures traceability and consistency by linking the price modification to a specific pricing mechanism, market data source, or previously established reference price.">
    instrumentId InstrumentId (0..*) <"Identification of the underlying asset, using public and/or private identifiers.">
    priceChangeAmount number (0..1) <"The numerical adjustment applied to the original price of the trade leg. It quantifies the increase or decrease in price due to the modification and is expressed as a decimal value.">
    newPrice number (0..1) <"The updated price of the trade leg after applying the change. It reflects the revised valuation of the leg or stream post-modification and is expressed as a decimal value.">

    condition Choice:
        optional choice priceReference, instrumentId

type TradeLegSizeChange: <"A structure describing a change to the size of a single leg or stream of a trade.">

    notionalReference NotionalReference (0..1) <"A reference to a specific notional amount, identified by the href attribute, which links to the corresponding notional definition.">
    changeInNotionalAmount NonNegativeMoney (0..1) <"A non-negative monetary value indicating the change in the notional amount.">
    outstandingNotionalAmount NonNegativeMoney (0..1) <"A non-negative monetary value indicating the remaining outstanding notional amount.">
    numberOfOptionsReference NumberOfOptionsReference (0..1) <"A reference to a specific notional quantity of options, identified by the href attribute, which links to the corresponding notional definition.">
    changeInNumberOfOptions number (0..1) <"Specifies the numerical change in the quantity of options as a decimal value, indicating an increase or decrease.">
    outstandingNumberOfOptions number (0..1) <"The remaining number of options after adjustments, expressed as a decimal value.">
    numberOfUnitsReference NumberOfUnitsReference (0..1) <"A reference to a specific notional quantity of units, identified by the href attribute, which links to the corresponding notional definition.">
    changeInNumberOfUnits number (0..1) <"Specifies the numerical change in the quantity of units as a decimal value, indicating an increase or decrease.">
    outstandingNumberOfUnits number (0..1) <"The remaining number of units after adjustments, expressed as a decimal value.">
    notionalScheduleReference NotionalReference (0..1) <"A reference to a specific notional schedule, identified by the href attribute, which links to the corresponding notional schedule definition.">
    changeInNotionalSchedule NonNegativeAmountSchedule (0..1) <"A non-negative schedule of changes to the notional amount over time. It may specify the currency in which these changes occur.">
    outstandingNotionalSchedule NonNegativeAmountSchedule (0..1) <"A non-negative schedule indicating the remaining notional amounts over time. It may specify the currency in which these values are measured.">
    knownAmountReference AmountReference (0..1) <"A reference to a specific amount identified by the href attribute, which points to the corresponding amount definition.">
    changeInKnownAmount NonNegativeMoney (0..1) <"A non-negative monetary value indicating the change in the known amount.">
    outstandingKnownAmount NonNegativeMoney (0..1) <"A non-negative monetary value indicating the outstanding balance of the known amount.">

    condition Choice:
        if changeInNotionalAmount exists or outstandingNotionalAmount exists
        then changeInNotionalAmount exists
                and outstandingNotionalAmount exists
                and numberOfOptionsReference is absent
                and changeInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and numberOfUnitsReference is absent
                and changeInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and notionalScheduleReference is absent
                and changeInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and knownAmountReference is absent
                and changeInKnownAmount is absent
                and outstandingKnownAmount is absent
        else if changeInNumberOfOptions exists or outstandingNumberOfOptions exists
        then changeInNumberOfOptions exists
                and outstandingNumberOfOptions exists
                and changeInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and notionalReference is absent
                and numberOfUnitsReference is absent
                and changeInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and notionalScheduleReference is absent
                and changeInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and knownAmountReference is absent
                and changeInKnownAmount is absent
                and outstandingKnownAmount is absent
        else if changeInNumberOfUnits exists or outstandingNumberOfUnits exists
        then changeInNumberOfUnits exists
                and outstandingNumberOfUnits exists
                and changeInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and changeInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and notionalReference is absent
                and numberOfOptionsReference is absent
                and notionalScheduleReference is absent
                and changeInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and knownAmountReference is absent
                and changeInKnownAmount is absent
                and outstandingKnownAmount is absent
        else if changeInNotionalSchedule exists or outstandingNotionalSchedule exists
        then changeInNotionalSchedule exists
                and outstandingNotionalSchedule exists
                and changeInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and changeInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and changeInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and notionalReference is absent
                and numberOfOptionsReference is absent
                and numberOfUnitsReference is absent
                and knownAmountReference is absent
                and changeInKnownAmount is absent
                and outstandingKnownAmount is absent
        else if changeInKnownAmount exists or outstandingKnownAmount exists
        then changeInKnownAmount exists
                and outstandingKnownAmount exists
                and changeInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and changeInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and changeInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and changeInNotionalSchedule is absent
                and outstandingNotionalSchedule is absent
                and notionalReference is absent
                and numberOfOptionsReference is absent
                and numberOfUnitsReference is absent
                and notionalScheduleReference is absent
        else False

type TradeNotionalChange extends TradeChangeBase: <"A structure describing a change to the size of a trade.">

    changeInNotionalAmount NonNegativeMoney (0..*) <"Specifies the fixed amount by which the Notional Amount changes. The direction of the change (increase or decrease) is specified by the event type (Termination =&gt; reduction, Increase =&gt; greater.)">
    outstandingNotionalAmount NonNegativeMoney (0..*) <"Specifies the Notional amount after the Change">
    changeInNumberOfOptions number (0..1) <"Specifies the fixed amount by which the Number of Options changes">
    outstandingNumberOfOptions number (0..1) <"Specifies the Number of Options after the Change.">
    changeInNumberOfUnits number (0..1) <"Specifies the fixed amount by which the Number of Units changes">
    outstandingNumberOfUnits number (0..1) <"Specifies the Number of Units">
    sizeChange TradeLegSizeChange (0..*) <"Describes changes to the size or amount of a trade leg or stream. It can accommodate different types of changes, including alterations to the notional amount, number of options, units, or other fixed amounts.">
    priceChange TradeLegPriceChange (0..*) <"Captures any changes in the price of a trade leg or stream. This element can appear multiple times to represent different price changes, and it specifies how the price of a trade has been altered, including the new price and any associated amount of change.">

    condition Choice:
        if changeInNotionalAmount exists
        then changeInNumberOfOptions is absent
                and outstandingNumberOfOptions is absent
                and changeInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and sizeChange is absent
        else if changeInNumberOfOptions exists
        then changeInNotionalAmount is absent
                and outstandingNotionalAmount is absent
                and changeInNumberOfUnits is absent
                and outstandingNumberOfUnits is absent
                and sizeChange is absent
        else if changeInNumberOfUnits exists
        then changeInNotionalAmount is absent
                and changeInNumberOfOptions is absent
                and outstandingNotionalAmount is absent
                and outstandingNumberOfOptions is absent
                and sizeChange is absent
        else changeInNotionalAmount is absent
            and changeInNumberOfOptions is absent
            and changeInNumberOfUnits is absent
            and outstandingNotionalAmount is absent
            and outstandingNumberOfOptions is absent
            and outstandingNumberOfUnits is absent

type TradeNovationContent extends AbstractEvent: <"A structure describing a novation.">

    newTradeIdentifier PartyTradeIdentifier (0..*) <"Indicates a reference to the new trade between the transferee and the remaining party.">
    newTrade Trade (0..1) <"Indicates the new trade between the transferee and the remaining party.">
    oldTradeIdentifier PartyTradeIdentifier (0..*) <"Indicates a reference to the original trade between the transferor and the remaining party.">
    oldTrade Trade (0..1) <"Indicates the original trade between the transferor and the remaining party.">
    feeTradeIdentifier PartyTradeIdentifier (0..1) <"Indicates a reference to the implied trade (the \"fee trade\") that the associated novation fee based on. This is equivalent to the new trade that is created by the novation (between the transferee and the remaining party), but is between the transferor and the transferee. A reference to the Fee Trade supports regulatory reporting of novations.">
    feeTrade Trade (0..1) <"Indicates the implied trade (the \"fee trade\") that the associated novation fee based on. This is equivalent to the new trade that is created by the novation (between the transferee and the remaining party), but is between the transferor and the transferee. Fee Trade supports regulatory reporting of novations.">
    transferor PartyReference (0..1) <"A pointer style reference to a party identifier defined elsewhere in the document. In a three-way novation the party referenced is the Transferor (outgoing party) in the novation. The Transferor means a party which transfers by novation to a Transferee all of its rights, liabilities, duties and obligations with respect to a Remaining Party. In a four-way novation the party referenced is Transferor 1 which transfers by novation to Transferee 1 all of its rights, liabilities, duties and obligations with respect to Transferor 2. ISDA 2004 Novation Term: Transferor (three-way novation) or Transferor 1 (four-way novation).">
    transferorAccount AccountReference (0..1) <"Reference to the account of the party transferring obligations under a novation agreement.">
    transferee PartyReference (0..1) <"A pointer style reference to a party identifier defined elsewhere in the document. In a three-way novation the party referenced is the Transferee (incoming party) in the novation. Transferee means a party which accepts by way of novation all rights, liabilities, duties and obligations of a Transferor with respect to a Remaining Party. In a four-way novation the party referenced is Transferee 1 which accepts by way of novation the rights, liabilities, duties and obligations of Transferor 1. ISDA 2004 Novation Term: Transferee (three-way novation) or Transferee 1 (four-way novation).">
    otherTransferee PartyReference (0..1) <"A pointer style reference to a party identifier defined elsewhere in the document. In a five-way novation the party referenced is the Transferee\'s legal entity that is involved in the settlement of the fee leg of the novation transaction (this might be a different legal entity than the one that assumes the novation trade). NB: this element has been added pending confirmation of the business need/context in which it would be used, and might not appear in a subsequent draft of this schema.">
    transfereeAccount AccountReference (0..1) <"Reference to the account of the party receiving the transferred obligations under the novation agreement.">
    otherTransfereeAccount AccountReference (0..1) <"Reference to an additional account associated with the transferee, if applicable.">
    remainingParty PartyReference (0..1) <"A pointer style reference to a party identifier defined elsewhere in the document. In a three-way novation the party referenced is the Remaining Party in the novation. Remaining Party means a party which consents to a Transferor\'s transfer by novation and the acceptance thereof by the Transferee of all of the Transferor\'s rights, liabilities, duties and obligations with respect to such Remaining Party under and with respect of the Novated Amount of a transaction. In a four-way novation the party referenced is Transferor 2 per the ISDA definition and acts in the role of a Transferor. Transferor 2 transfers by novation to Transferee 2 all of its rights, liabilities, duties and obligations with respect to Transferor 1. ISDA 2004 Novation Term: Remaining Party (three-way novation) or Transferor 2 (four-way novation).">
    remainingPartyAccount AccountReference (0..1) <"Reference to the account of the party retaining certain obligations after the novation.">
    otherRemainingParty PartyReference (0..1) <"A pointer style reference to a party identifier defined elsewhere in the document. This element is not applicable in a three-way novation and should be omitted. In a four-way novation the party referenced is Transferee 2. Transferee 2 means a party which accepts by way of novation the rights, liabilities, duties and obligations of Transferor 2. ISDA 2004 Novation Term: Transferee 2 (four-way novation).">
    otherRemainingPartyAccount AccountReference (0..1) <"Reference to an additional account associated with the remaining party, if applicable.">
    novationDate zonedDateTime (0..1) <"Specifies the date that one party\'s legal obligations with regard to a trade are transferred to another party. It corresponds to the Novation Date section of the 2004 ISDA Novation Definitions, section 1.16.">
    executionDateTime ExecutionDateTime (0..1) <"The date and time at which the change was agreed.">
    novationTradeDate zonedDateTime (0..1) <"Specifies the date the parties agree to assign or novate a Contract. If this element is not specified, the novationContractDate will be deemed to be the novationDate. It corresponds to the Novation Trade Date section of the 2004 ISDA Novation Definitions, section 1.17.">
    novatedAmount Money (0..*) <"The amount which represents the portion of the Old Contract being novated.">
    remainingAmount Money (0..*) <"The amount which represents the portion of the Old Contract not being novated.">
    novatedNumberOfOptions number (0..1) <"The number of options which represent the portion of the Old Contract being novated.">
    remainingNumberOfOptions number (0..1) <"The number of options which represent the portion of the Old Contract not being novated.">
    novatedNumberOfUnits number (0..1) <"The number of options which represent the portion of the Old Contract being novated.">
    remainingNumberOfUnits number (0..1) <"The number of options which represent the portion of the Old Contract not being novated.">
    novationAmount TradeLegSizeChange (0..*) <"The financial adjustment associated with a novation event, where a trade\'s obligations are transferred from one party to another. It captures changes in trade leg size, such as notional amount, number of options, number of units, scheduled notional adjustments, or fixed amount modifications. This element ensures accurate representation of contractual amendments resulting from a novation.">
    fullFirstCalculationPeriod boolean (0..1) <"This element corresponds to the applicability of the Full First Calculation Period as defined in the 2004 ISDA Novation Definitions, section 1.20.">
    firstPeriodStartDate FirstPeriodStartDate (0..2) <"Element that is used to be able to make sense of the “new transaction” without requiring reference back to the “old transaction”. In the case of interest rate products there are potentially 2 “first period start dates” to reference – one with respect to each party to the new transaction. For Credit Default Swaps there is just the one with respect to the party that is the fixed rate payer.">
    nonReliance Empty (0..1) <"This element corresponds to the non-Reliance section in the 2004 ISDA Novation Definitions, section 2.1 (c) (i). The element appears in the instance document when non-Reliance is applicable.">
    creditDerivativesNotices CreditDerivativesNotices (0..1) <"This element should be specified if one or more of either a Credit Event Notice, Notice of Publicly Available Information, Notice of Physical Settlement or Notice of Intended Physical Settlement, as applicable, has been delivered by or to the Transferor or the Remaining Party. The type of notice or notices that have been delivered should be indicated by setting the relevant boolean element value(s) to true. The absence of the element means that no Credit Event Notice, Notice of Publicly Available Information, Notice of Physical Settlement or Notice of Intended Physical Settlement, as applicable, has been delivered by or to the Transferor or the Remaining Party.">
    contractualDefinitions ContractualDefinitions (0..*) <"The definitions (such as those published by ISDA) that will define the terms of the novation transaction.">
    contractualTermsSupplement ContractualTermsSupplement (0..*) <"A contractual supplement (such as those published by ISDA) that will apply to the trade.">
    payment Payment (0..1) <"Describes a payment made in settlement of the novation.">

    condition Choice0:
        optional choice newTradeIdentifier, newTrade

    condition Choice1:
        optional choice novatedAmount, novatedNumberOfOptions, novatedNumberOfUnits, novationAmount

    condition Choice2:
        if novatedAmount exists
        then remainingNumberOfOptions is absent
                and remainingNumberOfUnits is absent
                and optional choice oldTradeIdentifier, oldTrade
                and if oldTradeIdentifier exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTrade exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTradeIdentifier is absent and oldTrade is absent
                    then optional choice feeTradeIdentifier, feeTrade

    condition Choice3:
        if novatedNumberOfOptions exists
        then remainingAmount is absent
                and remainingNumberOfUnits is absent
                and optional choice oldTradeIdentifier, oldTrade
                and if oldTradeIdentifier exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTrade exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTradeIdentifier is absent and oldTrade is absent
                    then optional choice feeTradeIdentifier, feeTrade

    condition Choice4:
        if novatedNumberOfUnits exists
        then remainingAmount is absent
                and remainingNumberOfOptions is absent
                and optional choice oldTradeIdentifier, oldTrade
                and if oldTradeIdentifier exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTrade exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTradeIdentifier is absent and oldTrade is absent
                    then optional choice feeTradeIdentifier, feeTrade

    condition Choice5:
        if novationAmount exists
        then remainingAmount is absent
                and remainingNumberOfOptions is absent
                and remainingNumberOfUnits is absent
                and optional choice oldTradeIdentifier, oldTrade
                and if oldTradeIdentifier exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTrade exists
                    then optional choice feeTradeIdentifier, feeTrade
                and if oldTradeIdentifier is absent and oldTrade is absent
                    then optional choice feeTradeIdentifier, feeTrade

    condition Choice6:
        if novatedAmount is absent
                and novatedNumberOfOptions is absent
                and novatedNumberOfUnits is absent
                and novationAmount is absent
        then remainingAmount is absent
                and remainingNumberOfOptions is absent
                and remainingNumberOfUnits is absent
                and optional choice oldTradeIdentifier, oldTrade
                and optional choice feeTradeIdentifier, feeTrade

type TradingEventSummary: <"A type that records a short form event history of a trade.">

    eventIdentifier BusinessEventIdentifier (0..*) <"Uniquely identifies a business event associated with a trade. It provides essential references for tracking and managing lifecycle events in financial transactions.">
    eventType EventType (1..1) <"Specifies the category or nature of the business event affecting the trade. It provides a standardized classification of trading events, facilitating consistent interpretation and reporting.">
    agreementDate zonedDateTime (0..1) <"The date on which the change was agreed.">
    executionDateTime ExecutionDateTime (0..1) <"The date and time at which the negotiated change to the terms of the original contract was agreed, such as via telephone or electronic trading system (i.e., agreement date/time).">
    effectiveDate zonedDateTime (0..1) <"The date on which the change become effective.">
    notionalChange NotionalChangeEnum (0..1) <"Indication as to whether the transaction is an increase or decrease of notional of a derivative contract. Only applies when there is change in notional for a derivative contract">
    changeInNotional MoneyRef (0..*) <"The change in notional amount for a prior report as a result of this event. The current notional will be reported in the trade itself. This corresponds to MiFIR Nominal or Monetary amount values; these can be distinguished by the esmaNotionalType indicator.">
    changeInNumberOfOptions AmountRef (0..*) <"The change in nominal amount from a prior report as a result of this event. The current number of options will be reported in the trade itself. This corresponds to the MiFIR \"units\" value.">
    changeInQuantity UnitQuantityRef (0..*) <"The change in quantity(s) from a prior report as a result of this event. The current quantity will be reported in the trade itself. This corresponds to the MiFIR \"units\" value.">
    payment NonNegativePayment (0..1) <"A fee which compensates one of the parties for taking on a position that is off market.">

    condition Choice:
        optional choice changeInNotional, changeInNumberOfOptions, changeInQuantity

type TouchRateObservation extends TriggerRateObservation: <"An observation of a trigger rate in structured financial products, particularly in exotic derivatives where touch/no-touch events determine payouts. It extends the TriggerRateObservation base type and includes additional details related to exercise, settlement, and payment.">

    exerciseSide ExerciseSideEnum (0..1) <"Specifies whether the option can be exercised by the buyer or seller, using predefined values from ExerciseSideEnum: { (\"Put\" | \"Call\") | (\"Payer\" | \"Receiver\") }.">
    settlementType SettlementTypeEnum (0..1) <"Specifies the method of settlement when the touch event occurs. It can take one of four values: Cash (the contract settles with a cash payment), Physical (the contract settles through physical delivery of the underlying asset), Election (the settlement type is chosen based on pre-agreed election terms, or CashOrPhysical (the party has the option to choose between cash or physical settlement).">
    cashSettlement SimplePayment (0..1) <"Defines the cash amount payable upon settlement.">
    physicalSettlement PhysicalSettlement (0..1) <"Specifies the terms for settling through asset delivery.">
    payment NonNegativePayment (0..1) <"Represents the non-negative payment amount due when the touch event is triggered.">
    clearingInstructions ClearingInstructions (0..1) <"Contains details for clearing the trade.">
    isExercisable boolean (0..1) <"If the touch or no touch event hasn\'t generated an exercise, then we specify whether the option is exercisable or not.">

    condition Choice0:
        isExercisable is absent
            or exerciseSide is absent
                and payment is absent
                and clearingInstructions is absent

    condition Choice1:
        optional choice settlementType, cashSettlement, physicalSettlement, isExercisable

type TriggerRateObservation: <"Represents the details of a rate-based trigger event, specifying the observed market conditions that determine whether the trigger has been met.">

    observationDate zonedDateTime (0..1) <"The date on which the rate observation occurred, in order to trigger the barrier event.observationDate">
    observationTime BusinessCenterTime (0..1) <"The time at which the observation occurred.">
    informationSource InformationSource (0..1) <"The market source used to obtain the observed rate or price. It provides details about where the rate was published, ensuring transparency and consistency in financial transactions.">
    triggerRate number (0..1) <"The rate value (level) which was attained/breached, in order to trigger the barrier event.">
    quotedCurrencyPair QuotedCurrencyPair (0..1) <"Defines the currency pair and quote basis for an FX rate.">
    observedRate number (0..1) <"The observed rate value which triggered the barrier event.">
    triggerPrice PositiveMoney (0..1) <"The price value (level) which was attained/breached, in order to trigger the barrier event.">
    observedPrice PositiveMoney (0..1) <"The observed price value which triggered the barrier event.">
    triggerCondition TriggerConditionEnum (0..1) <"The side of the trigger rate/price (level) on which a rate observation occurred, in order to trigger the barrier event.">

    condition Choice:
        triggerPrice is absent and observedPrice is absent
            or triggerRate is absent
                and quotedCurrencyPair is absent
                and observedRate is absent

type Withdrawal: <"A structure describing the removal of a trade from a service, such as a reporting service.">

    partyTradeIdentifier PartyTradeIdentifier (0..*) <"Identifiers of the trade that is being withdrawn.">
    partyTradeInformation WithdrawalPartyTradeInformation (0..*) <"Holds party-specific information about the trade that is being withdrawn from.">
    trade Trade (0..1) <"The full trade representation that is being withdrawn.">
    effectiveDate zonedDateTime (0..1) <"Specifies the date when the withdrawal action becomes effective.">
    requestedAction RequestedWithdrawalAction (0..1) <"Specifies the action requested for the withdrawal. It points to a URI that identifies the coding scheme used for this action. The element is optional, meaning that a withdrawal may or may not have an associated requested action.">
    reason WithdrawalReason (0..*) <"Specifies the reason for the withdrawal. The reason element can appear multiple times (unbounded) within the withdrawal, and each instance can refer to a different reason for the action.">
    reportingRegime ReportingRegimeIdentifier (0..*) <"DEPRECATED. The supervisor/regulator to which this withdrawal applies">

    condition Choice:
        trade is absent
            or partyTradeIdentifier is absent and partyTradeInformation is absent

type WithdrawalPartyTradeInformation: <"A type defining party-specific additional information that may be recorded against a trade, for withdrawal purposes.">

    partyReference PartyReference (1..1) <"Reference to a party.">
    accountReference AccountReference (0..1) <"Reference to an account.">
    relatedParty RelatedParty (0..*) <"This may be used to identify one or more parties that perform a role within the transaction. If this is within a partyTradeInformation block, the related party performs the role with respect to the party identifie by the \"partyReference\" in the partyTradeInformation block.">
    category TradeCategory (0..*) <"Used to categorize trades into user-defined categories, such as house trades vs. customer trades.">
    reportingRegime ReportingRegimeIdentifier (0..*) <"Allows the organization to specify which if any relevant regulators or other supervisory bodies this is relevant for, and what reporting rules apply.">

type WithdrawalReason: <"A type that describes why a trade was withdrawn.">

    value Scheme (1..1)
    withdrawalReasonScheme NonEmptyURI (0..1)

type UnitQuantityRef extends UnitQuantity: <"A type defining a quantity and unit with a reference.">

    quantityReference NotionalReference (0..1) <"A reference to a previously defined notional amount or quantity, ensuring consistency and avoiding duplication in trade documentation.">

type CreditEventType: <"A type that describes which credit event is taking place, e.g. Bankruptcy, FailureToPay, etc.">

    value Scheme (1..1)
    creditEventTypeScheme NonEmptyURI (0..1)

type ClearingStatusItem: <"A component of a clearing status report. This provides the clearing status for a single trade.">

    tradeIdentifier TradeIdentifier (0..*) <"Identifier(s) for the trade which is the subject of the clearing request to which this status relates.">
    tradeReferenceInformation TradeReferenceInformation (0..1) <"Information about a trade.">
    trade Trade (0..1) <"Complete economics of the trade">
    tradePackage TradePackage (0..1) <"A collection of trades grouped together as a single unit for reporting purposes. This aggregation facilitates the management and reporting of multiple trades under a unified identifier, streamlining the processing and analysis of related transactions.">
    quote BasicQuotation (0..*) <"Pricing information for the trade.">
    clearingStatusValue ClearingStatusValue (1..1) <"The status of the clearing process for the identified trade. For example, Received, Pending (Approval), Registered (i.e. cleared), Rejected, etc.">
    updatedDateTime zonedDateTime (0..1) <"When the clearing status changed to the current value. This is mostly useful if the clearing status messages could be delayed from when the status actually changes; this could be important if the status date is used as the basis of any settlement calculations.">
    reason Reason (0..*) <"Supporting information which may be produced to explain the clearing process status. This may be a business reason e.g. failed eligibility criteria for a trade in Rejected status.">
    statusAppliesTo PartyReference (0..2) <"Reference to parties currently in this status, e.g. parties for which we are awaiting approval. For example, if a trade is in \"Pending\" status, this would identify which parties\' approval the trade was pending.">

    condition Choice:
        required choice tradeIdentifier, tradeReferenceInformation, trade, tradePackage

type CompressionActivity: <"A type that shows how multiple trades have been combined into a result.">

    compressionType CompressionType (0..1) <"The method of trade amalgamation applied, such as netting or portfolio compression. This structure allows for the categorization of compression activities within financial transactions.">
    replacementTradeIdentifier TradeIdentifier (0..1) <"Specifies the identifier for a trade that replaces a previous one. This is commonly used in scenarios such as trade novations or corrections, where an existing trade is supplanted by a new one.">
    originatingTradeIdentifier TradeIdentifier (0..*) <"Specifies the identifier(s) of the original trade(s) from which a current trade is derived. This is particularly relevant in scenarios such as cleared trades, where the originatingTradeIdentifier references the ID of the trade submitted for clearing.">
    replacementTradeId TradeId (0..1) <"A deprecated identifier for a trade, represented by the TradeId type. It has been replaced by the replacementTradeIdentifier element.">
    originatingTradeId TradeId (0..*) <"A deprecated identifier used to reference the identifier(s) of original trade(s) from which a current trade originated. It has been replaced in favor of the originatingTradeIdentifier element.">

    condition Choice:
        replacementTradeId is absent and originatingTradeId is absent
            or replacementTradeIdentifier is absent and originatingTradeIdentifier is absent

type CompressionType: <"A type that identifies the type of trade amalgamation, for example netting or portfolio compression.">

    value Scheme (1..1)
    compressionTypeScheme NonEmptyURI (0..1)

type CreditLimitBase: <"A structure describing a basic credit limit.">

    limitId LimitId (1..1) <"Specifies a unique identifier for a credit limit, as defined by a particular scheme.">
    primaryAssetClass AssetClass (0..1) <"A classification of the most important risk class of the trade. FpML defines a simple asset class categorization using a coding scheme.">
    secondaryAssetClass AssetClass (0..*) <"A classification of additional risk classes of the trade, if any. FpML defines a simple asset class categorization using a coding scheme.">
    productType ProductType (0..*) <"A classification of the type of product. FpML defines a simple product categorization using a coding scheme.">
    productId ProductId (0..*) <"A product reference identifier. The product ID is an identifier that describes the key economic characteristics of the trade type, with the exception of concepts such as size (notional, quantity, number of units) and price (fixed rate, strike, etc.) that are negotiated for each transaction. It can be used to hold identifiers such as the \"UPI\" (universal product identifier) required by certain regulatory reporting rules. It can also be used to hold identifiers of benchmark products or product temnplates used by certain trading systems or facilities. FpML does not define the domain values associated with this element. Note that the domain values for this element are not strictly an enumerated list.">
    assetClass AssetClass (0..*) <"A classification of the risk class of the trade. FpML defines a simple asset class categorization using a coding scheme.">
    currency Currency (1..1) <"Specifies the currency in which the credit limit is denominated.">
    tenor Period (1..1) <"The maximum allowed tenor for a trade under this limit. When this structure is used as part of a suspendCredit message, this tenor imposes a temporary tenor limit on allowed trade types.">

type CreditLimit extends CreditLimitBase: <"A structure describing a credit limit with applicability constraints.">

    limitApplicable LimitApplicable (1..*) <"Specifies the constraints and details of a credit limit that is applicable to a particular product or transaction.">
    expirationDate zonedDateTime (0..1) <"Specifies the date and time when the credit limit becomes invalid or expires.">

type CreditLimitInformation: <"A collection of credit limit details associated with a specific party. This structure facilitates the management and reporting of credit limits within financial transactions.">

    partyInformation PartyTradeInformation (1..1) <"Details about the party associated with the credit limit, including identifiers, names, and related party information. It is an optional element and, when present, provides essential information about the party involved in the credit limit arrangement.">
    limitModel LimitModelEnum (1..1) <"Specifies the model used to determine credit limits within a credit limit agreement. Can take one of the following values: \"Ping\", \"Plus1ToStop\", \"Plus1ToPing\", \"PushToPing\", \"PushToStop\".">
    creditLimit CreditLimit (1..*) <"A structure that defines a credit limit with specific applicability constraints. This structure allows for detailed specification of credit limits within financial transactions.">

type CreditLimitUtilization: <"Represents the usage of a credit limit, detailing both executed and pending positions. It comprises two optional elements: executed and pending, both of which are of type CreditLimitUtilizationPosition. These elements provide a breakdown of the credit limit utilization, distinguishing between amounts that have been executed and those that are pending. This structure allows for a clear representation of how much of the credit limit has been utilized and how much is still pending execution.">

    executed CreditLimitUtilizationPosition (1..1) <"Credit limit utilization attributable to executed trades.">
    pending CreditLimitUtilizationPosition (1..1) <"Credit limit utilization attributable to pending unexecuted orders.">

type CreditLimitUtilizationPosition: <"Specifies the utilization of a credit limit, detailing positions in terms of short, long, and global amounts.">

    short NonNegativeDecimal (0..1) <"Credit limit utilization attributable to short positions.">
    long NonNegativeDecimal (0..1) <"Credit limit utilization attributable to long positions.">
    global NonNegativeDecimal (0..1) <"Global credit limit utilization amount, agnostic of long/short position direction.">

    condition Choice:
        if short exists
        then long exists
        else if global exists
        then long is absent
        else False

type DeClear: <"A structure describing a declear event. The deClear event allows a firm to request that a trade be removed from clearing, or a clearing service to request consent for this, or to report that is has been done.">

    tradeIdentifier PartyTradeIdentifier (1..*) <"Specifies one or more identifiers assigned to a trade by a party, facilitating the association of the trade with related transactions.">
    effectiveDate zonedDateTime (1..1) <"Specifies the date on which the declear event becomes effective, indicating when the trade is officially removed from clearing.">
    reason DeclearReason (0..1) <"Specifies the rationale for removing a trade from clearing.">

type DeclearReason: <"A type that describes why a trade was removed from clearing.">

    value Scheme (1..1)
    declearReasonScheme NonEmptyURI (0..1)

type EventProposedMatch: <"A structure that describes a proposed match between trades or post-trade event reports.">

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    change TradeChangeContent (0..1) <"Represents the change event associated with a trade.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Represents an additional customized event serving as the event report subject of the proposed match.">
    matchId MatchId (0..1) <"A unique identifier assigned by the matching service to each set of matched positions.">
    difference TradeDifference (0..*) <"A type used to record the details of a difference between two sides of a business event.">
    matchScore number (0..1) <"Numeric score to represent the quality of the match.">

    condition Choice:
        if tradePackage exists
        then originatingEvent is absent
                and trade is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if trade exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if amendment exists
        then increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if increase exists
        then terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if termination exists
        then novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if novation exists
        then terminatingEvent is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if withdrawal exists
        then terminatingEvent is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if observation exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if reset exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if change exists
        then reset is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if optionExercise exists
        then reset is absent
                and change is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if optionExpiry exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if optionEvent exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if additionalEvent exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
        else False

type EventsChoice: <"Defines a choice among various event groups and an additional event element. It allows for the selection of one option from the following: TradingEventsBase.model, PostTradeEventsBase.model, ChangeEventsBase.model, OptionsEventsBase.model, and an additionalEvent, which is an element for any supplementary events not covered by the predefined groups. In summary, this structure provides flexibility in representing various event types within FpML.">

    tradePackage TradePackage (0..1) <"A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.">
    originatingEvent OriginatingEvent (0..1) <"Specifies the underlying event that triggered the creation of a trade. It is defined as a coded value based on an external scheme, allowing for standardized classification of trade origins, such as novations, amendments, or corporate actions. This element helps track the trade lifecycle by linking it to its originating context.">
    trade Trade (0..1) <"The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.">
    amendment TradeAmendmentContent (0..1) <"Records modifications to an existing trade, specifying the updated trade details, agreement terms, and any related payments or notional changes.">
    increase TradeNotionalChange (0..1) <"Reflects a change in the trade\'s notional amount or size, capturing adjustments to its economic terms, including price and quantity modifications.">
    terminatingEvent TerminatingEvent (0..1) <"This may be used to describe why a trade was terminated.">
    termination TradeNotionalChange (0..1) <"Documents the full or partial closure of a trade, reducing or eliminating its notional exposure, often due to settlement, early closeout, or expiration.">
    novation TradeNovationContent (0..1) <"Represents the transfer of a trade from one counterparty to another, detailing the original and new trades, fees, payment obligations, and updated contractual terms.">
    withdrawal Withdrawal (0..1) <"Indicates the removal or cancellation of a trade from reporting or processing systems, including identifiers, reasons, effective date, and requested actions.">
    observation ObservationEvent (0..*) <"Captures a recorded market event, including date, time, price, rate type, and source, often used in derivatives pricing or index calculations.">
    reset ResetEvent (0..*) <"Defines the periodic adjustment of a trade\'s rate or value, specifying the reference trade, date, calculated reset value, and any relevant details affecting financial terms.">
    change TradeChangeContent (0..1) <"Represents the change event associated with a trade.">
    optionExercise OptionExercise (0..1) <"A structure describing an option exercise event. The optionExercise event supports partial exercise (specify the number of options or amount to exercise), full exercise (use fullExercise flag), as well as the option to request options not to be exercised.">
    optionExpiry OptionExpiry (0..*) <"A structure describing an option expiring event (i.e. passing its last exercise time and becoming worthless.)">
    optionEvent OptionEvent (0..1) <"A structure describing knock in, knock out, touch and no touch events.">
    additionalEvent AdditionalEvent (0..1) <"Represents a supplementary lifecycle event not covered by the predefined trading, post-trade, change, or options event categories.">

    condition Choice:
        if tradePackage exists
        then originatingEvent is absent
                and trade is absent
                and amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if trade exists
        then amendment is absent
                and increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if amendment exists
        then increase is absent
                and terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if increase exists
        then terminatingEvent is absent
                and termination is absent
                and novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if termination exists
        then novation is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if novation exists
        then terminatingEvent is absent
                and withdrawal is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if withdrawal exists
        then terminatingEvent is absent
                and observation is absent
                and reset is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if observation exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if reset exists
        then terminatingEvent is absent
                and originatingEvent is absent
                and change is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if change exists
        then reset is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and optionExercise is absent
                and optionExpiry is absent
                and optionEvent is absent
                and additionalEvent is absent
        else if optionExercise exists
        then reset is absent
                and change is absent
                and optionExpiry is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
        else if optionExpiry exists
        then reset is absent
                and change is absent
                and optionExercise is absent
                and optionEvent is absent
                and originatingEvent is absent
                and terminatingEvent is absent
                and additionalEvent is absent
