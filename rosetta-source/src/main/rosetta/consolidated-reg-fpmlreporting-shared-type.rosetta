namespace fpml.consolidated.reg.fpmlreporting.shared : < "fpml definition" >
version "${project.version}"

import fpml.consolidated.doc.*
import fpml.consolidated.msg.*
import fpml.consolidated.repo.*
import fpml.consolidated.shared.*

type RegulatoryReportingStatus extends RegulatoryReportingStatusMessage: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Used to report the status of reporting on a trade to any \t\t\t\tregulators.">
    [rootType]

type RequestRegulatoryReportingStatus extends RequestRegulatoryReportingStatusMessage: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Used to request the status of reporting on a trade to any \t\t\t\tregulators.">
    [rootType]

type ApplicableRegulations: <"Specifies the list ofregulations the trade is subject to \t\t\t\treporting. DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25).">

    regulatorApplicability RegulatorApplicability (1..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25).">

type CollateralPortfolio: <"The CollateralPortfolio component provides the ability to specify the \t\t\t\tcollateral in support of the transaction reporting as of a particular value date. It \t\t\t\tincludes unbounded choice of cash or nonCash collateral. This model would allow \t\t\t\tmixing cash and non-cash collateral without any regards to order. In real life \t\t\t\ttransaction, you almost always see some cash or a collection of non-cash collateral \t\t\t\tblocs.">

    valueDate zonedDateTime (1..1) <"Specifies the date as of which the reported cash and non-cash collateral positions and total valuation amounts apply.">
    collateralPortfolioChoice CollateralPortfolioChoice (0..*)
    totalValuationAmount PositiveMoney (0..*) <"Represents aggregated Market / Fair Value \t\t\t\t\t\tamount.">

type CollateralPortfolioChoice:

    cash PositiveMoney (0..1) <"Represents the amount of cash posted as collateral. The \t\t\t\t\t\t\tcash collateral component is simple, just an instance of PositiveMoney \t\t\t\t\t\t\ttype.">
    nonCash CollateralPosition (0..1) <"Represents the type and the amount of security (non-cash) \t\t\t\t\t\t\tposted as collateral. The nonCash collateral component uses \t\t\t\t\t\t\tSecurityValuation.model to state what security it is, how much and the \t\t\t\t\t\t\tcurrent dirty price. It also includes optional ability to specify the \t\t\t\t\t\t\tmargin or haircut that applies to this piece of \t\t\t\t\t\t\tcollateral.">

    condition Choice:
        optional choice cash, nonCash

type CollateralPortfolioId: <"A collateral portfolio identifier expressed as a text value and optionally qualified by the URI of an external reference scheme.">

    value Scheme (1..1)
    collateralPortfolioIdScheme NonEmptyURI (0..1)

type CollateralPosition extends SecurityValuation: <"A valuation of security collateral, optionally qualified by either a margin ratio or haircut expressed as a decimal fraction.">

    marginRatio DecimalFraction (0..1) <"An element defining an initial margin expressed \t\t\t\t\t\t\t\t\tas a ratio of the Market Value of the collateral to the Purchase \t\t\t\t\t\t\t\t\tPrice. A default value of initial margin ratio of 1.00 means \t\t\t\t\t\t\t\t\tthere is no margin and thus no risk related with the collateral. \t\t\t\t\t\t\t\t\tSee GMRA 2000 paragraph 2(z) and GMRA 2011 paragraph \t\t\t\t\t\t\t\t\t2(bb).">
    haircut DecimalFraction (0..1) <"An element defining a haircut expressed as the \t\t\t\t\t\t\t\t\tpercentage difference between the Market Value of the collateral \t\t\t\t\t\t\t\t\tand the Purchase Price of the repo and calculated as 100 \t\t\t\t\t\t\t\t\tmultiplied by a ratio of the difference between the Market Value \t\t\t\t\t\t\t\t\tof the collateral and the Purchase Price of the repo to the \t\t\t\t\t\t\t\t\tMarket Value of the collateral. Haircut is alternative way to \t\t\t\t\t\t\t\t\tadjust the value of collateral sold in a repurchase agreement to \t\t\t\t\t\t\t\t\tinitial margin ratio. Because an initial margin is a percentage \t\t\t\t\t\t\t\t\tof the Purchase Price, while a haircut is a percentage of the \t\t\t\t\t\t\t\t\tMarket Value of collateral, the arithmetic of initial margins \t\t\t\t\t\t\t\t\tand haircuts is slightly different. For example, an initial \t\t\t\t\t\t\t\t\tmargin of 102% is not equivalent to a haircut of 2%, but to \t\t\t\t\t\t\t\t\t1.961% (ie 100/102%). See GMRA 2011 paragraph \t\t\t\t\t\t\t\t\t2(aa).">

    condition Choice:
        optional choice marginRatio, haircut

type DisseminationId: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). The data type used for dissemination identifiers.">

    value NonEmptyScheme (1..1)
    id string (0..1)
    disseminationIdScheme NonEmptyURI (0..1)

type PublicDissemination: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Information related to the public dissemination.">

    disseminationId DisseminationId (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Specifies the disseminationId used for public \t\t\t\t\t\treporting.">
    publicationTime zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t2025-09-25). The date and time the public report was \t\t\t\t\t\t\tdisseminated.">
    projectedTime zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t2025-09-25). The date and time the public report is projected to be \t\t\t\t\t\t\tdisseminated.">
    withdrawn zonedDateTime (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). The date and time the public report was withdrawn from the \t\t\t\t\t\tpublic tape.">

    condition Choice:
        optional choice publicationTime, projectedTime

type RegulationName: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). An identifier of a regulation used for regulatory reporting, for \t\t\t\texample CFTC_PART43, CFTC_PART45, CSA_2013, etc.">

    value Scheme (1..1)
    regulationNameScheme NonEmptyURI (0..1)

type RegulatorApplicability: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). Specifies the trade is subject to this \t\t\t\tregulation.">

    supervisoryBody string (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25).">
    regulation RegulationName (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25).">
    reportingPartyReference PartyReference (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). A reference to the reporting party.">
    counterPartyReference PartyReference (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). A reference to the reporting party.">

type RegulatoryReportingCollateralization: <"A type defining collateral information to be \t\t\t\treported.">

    postingPartyReference PartyReference (1..1) <"A party that can post the collateral.">
    beneficiaryPartyReference PartyReference (0..1) <"A reference to the party for whose benefit the reported collateral is posted by the posting party.">
    holdingPartyReference PartyReference (0..1) <"A reference to the party that holds the collateral identified in the reported collateral portfolio.">
    collateralizedExposureGrouping CollateralizedExposureGrouping (0..1) <"Whether the trade collateralized exposure is calculated at \t\t\t\t\t\tthe individual (single) trade aggregation level or the net (multiple trades) \t\t\t\t\t\taggregation level. SFTR description of the field: Collateralization of net \t\t\t\t\t\texposure - Indicates whether the collateral has been provided for a net \t\t\t\t\t\texposure, rather than for a single transaction (\'true\' or \t\t\t\t\t\t\'false\').">
    collateralizationType CollateralizationType (0..1) <"Specifies how the transaction is collateralized by this \t\t\t\t\t\tparty, fully or partially, or uncollateralized. For Transparency view, the \t\t\t\t\t\toptions include Full, Partial, Uncollateralized, and One-Way. For \t\t\t\t\t\tRecordkeeping, the collateralization type refers to collateral that is \t\t\t\t\t\tposted by this firm, and One-Way option is not meaningful. In other words, \t\t\t\t\t\tif the collateralization type is Full, this trade is fully collateralized by \t\t\t\t\t\tthis party. SFTR description of the field: Uncollateralised SL flag - \t\t\t\t\t\tIndicates whether the securities lending transaction is uncollateralised \t\t\t\t\t\t(\'true\' or \'false\'). Uncollateralised SL will be \'true\', if \t\t\t\t\t\tcollateralizationType = \'Uncollateralized\'.">
    portfolioId CollateralPortfolioId (0..1) <"Provides code, or other identifier for the collateral \t\t\t\t\t\tportfolio to which this belongs. The collateral portfolio describes how \t\t\t\t\t\ttrades are aggregated for collateral calculation purposes. All trades that \t\t\t\t\t\tare aggregated together for collateral calculation purposes will share the \t\t\t\t\t\tsame collateral portfolio code. This code may come from different sources \t\t\t\t\t\tdepending on the level of aggregation defined in the CSA (e.g. it may be the \t\t\t\t\t\tLEI of a counterparty or a desk identifier). SFTR description of this field: Portfolio code - If the \t\t\t\t\t\ttransaction is cleared and is included in a portfolio of transactions for \t\t\t\t\t\twhich margins are exchanged, this portfolio should be identified by a unique \t\t\t\t\t\tcode determined by the reporting counterparty. 52 alphanumeric character \t\t\t\t\t\tcode including four special characters: .- _. Special characters are not \t\t\t\t\t\tallowed at the beginning and at the end of the code. No space \t\t\t\t\t\tallowed.">
    postedCollateral CollateralPortfolio (0..1) <"Information about the amount of collateral actually posted by \t\t\t\t\t\tthe posting party as of a particular value date.">

type RegulatorReportingStatusCode: <"DEPRECATED. Not in use (RPTWG decision 2025-09-25). A type that can be used to identify the reporting status of a \t\t\t\ttransaction. Examples include FullyReported, ReportedWithWarnings, NotReported, \t\t\t\tetc.">

    value Scheme (1..1)
    reportingStatusScheme NonEmptyURI (0..1)

type RegulatoryReportingStatusMessage extends Message: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25). A type defining message that can be used for returning the regulatory \t\t\t\treporting status of a trade.">

    header ResponseMessageHeader (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Standard FpML message header">
    tradeIdentifier PartyTradeIdentifier (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). identifies the affected trade">
    reportingStatus ReportingStatus (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Information about how the position is being reported \t\t\t\t\t\t\t\tto regulators.">
    party Party (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Reference information about parties, business units, \t\t\t\t\t\t\t\tand persons involed in the trade.">

type ReportingStatus: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25).">

    regimeName ReportingRegimeName (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Identifies the reporting regime under which this data is \t\t\t\t\t\treported. For example, Dodd-Frank, EMIR, MiFID, HongKongOTCDRepository, \t\t\t\t\t\tODRF">
    supervisoryBody SupervisoryBody (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Identifies the specific regulator or other supervisory body \t\t\t\t\t\tfor which this data is produced. For example, CFTC, SEC, UKFSA, ODRF, SFC, \t\t\t\t\t\tESMA.">
    regulation RegulationName (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Identifies the reporting regime under which this data is \t\t\t\t\t\treported. For example, Dodd-Frank, EMIR, MiFID, HongKongOTCDRepository, \t\t\t\t\t\tODRF">
    reportingRole ReportingRole (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Identifies the role of this party in reporting this trade \t\t\t\t\t\tfor this regulator; roles could include ReportingParty and Voluntary \t\t\t\t\t\treporting.">
    reportingPurpose ReportingPurpose (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). The reason this message is being sent, for example Snapshot, \t\t\t\t\t\tPET, Confirmation, RealTimePublic.">
    status RegulatorReportingStatusCode (1..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Describes the extent to which this trade is being reported to \t\t\t\t\t\tthe regime (e.g. Not reported, reported with warnings, fully \t\t\t\t\t\treported).">
    publicDissemination PublicDissemination (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Describes the extent to which this trade is being reported to \t\t\t\t\t\tthe regime (e.g. Not reported, reported with warnings, fully \t\t\t\t\t\treported).">
    reason Reason (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t2025-09-25). Used to describe and validation errors or warnings associated \t\t\t\t\t\twith the message for the regime.">

type RequestRegulatoryReportingStatusMessage extends AddressedMessage: <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t2025-09-25).">

    onBehalfOf OnBehalfOf (0..4) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). Indicates which party (or parties) (and accounts) a \t\t\t\t\t\t\t\ttrade or event is being processed for. Normally there will only be a \t\t\t\t\t\t\t\tmaximum of 2 parties, but in the case of a novation there could be a \t\t\t\t\t\t\t\ttransferor, transferee, remaining party, and other remaining party. \t\t\t\t\t\t\t\tAlso, in the context of a trade package there could be several \t\t\t\t\t\t\t\tparties for which limit check is requested, necessitating multiple \t\t\t\t\t\t\t\tonBehalfOf elements. Except for these cases, there should be no more \t\t\t\t\t\t\t\tthan two onBehalfOf references in a message.">
    tradeIdentifier PartyTradeIdentifier (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). identifies the affected trade">
    primaryAssetClass AssetClass (0..1) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). The asset class of the underlying \t\t\t\t\t\t\t\tproduct.">
    relatedParty RelatedParty (0..*) <"DEPRECATED. Not in use (RPTWG decision 2025-09-25).">
    party Party (0..*) <"DEPRECATED. Not in use (RPTWG decision \t\t\t\t\t\t\t\t2025-09-25). The supporting party definitions.">
